<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-corner outline used as the splash logo background: the ImageView
     clips its bitmap to this shape (clipToOutline), so the logo appears with
     rounded corners over the light splash background.
     Contorno de esquinas redondeadas usado como fondo del logo de la splash:
     el ImageView recorta el bitmap según esta forma (clipToOutline), así el
     logo aparece con bordes redondeados sobre el fondo claro. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EA3629" />
    <corners android:radius="32dp" />
</shape>
