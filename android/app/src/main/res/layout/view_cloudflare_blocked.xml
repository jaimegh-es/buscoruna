<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cloudflare_blocked_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="56dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Coruña Bus Header Icon & Name -->
        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Coruña Bus Logo"
            android:src="@drawable/ic_bus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Coruña Bus"
            android:textColor="#E53935"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Friendly Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="¡Ups! No logramos conectar por bloqueos de operadoras"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Detailed Explanation Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_blocked_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Por qué no carga la aplicación?"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="• Cloudflare es una empresa de infraestructura y seguridad de internet global utilizada por millones de páginas web legítimas en todo el mundo, incluida Coruña Bus.\n\n• Durante los partidos de fútbol, las operadoras españolas (Movistar, Vodafone, Orange, Digi...) ejecutan bloqueos masivos en cumplimiento de órdenes de LaLiga, cortando rangos enteros de IPs de Cloudflare y afectando por error a servicios como el autobús de A Coruña.\n\n• Los servidores de Coruña Bus funcionan con total normalidad y la app no tiene ningún virus ni fallo interno."
                android:textColor="#475569"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Solution Card: Proton VPN -->
        <LinearLayout
            android:id="@+id/btn_open_vpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_blocked_card"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Icono VPN"
                    android:src="@drawable/ic_vpn_key" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Solución recomendada: Proton VPN (Gratis)"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Abrir enlace"
                    android:src="@drawable/ic_external_link" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Proton VPN ofrece un plan 100% gratuito e ilimitado. Al activarla, se esquiva el bloqueo de tu operadora y Coruña Bus funciona al instante."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Check Block Card: hayahora.futbol -->
        <LinearLayout
            android:id="@+id/btn_check_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_blocked_card"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 Comprobar bloqueo en hayahora.futbol"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Abrir comprobador"
                    android:src="@drawable/ic_external_link" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Comprueba si tu operadora tiene bloqueado inled.es en este momento."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Transparency & Audit Card: GitHub -->
        <LinearLayout
            android:id="@+id/btn_open_github"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_blocked_card"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="GitHub Logo"
                    android:src="@drawable/ic_github" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Auditar código en GitHub (Open Source)"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Abrir GitHub"
                    android:src="@drawable/ic_external_link" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="Coruña Bus es una app comunitaria, 100% de código abierto y transparente. Puedes auditar todo el código fuente en GitHub."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Retry Action Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_retry_connection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_blocked_button_primary"
                android:drawableStart="@drawable/ic_refresh"
                android:elevation="2dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Reintentar conexión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_retry"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_retry_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Sigue bloqueado por tu operador. Activa Proton VPN." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
