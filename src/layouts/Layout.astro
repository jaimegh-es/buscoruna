<script>
    import { tracking } from "../utils/tracking";
    import { API, isApiLoading, isApiCooldownActive } from "../services/api";
    import { storage } from "../utils/storage";
    import { getTranslations } from "../utils/i18n";
    import { inAppAlert } from "../utils/inAppAlert";
    import {
        isNativePlatform,
        getBgConfig,
        setBgConfig,
        requestBgAlertPermission,
        checkBgAlertPermission,
        startForegroundChecker,
        stopForegroundChecker,
        resetAlertState,
        startNativeBackgroundTracking,
        stopNativeBackgroundTracking,
    } from "../utils/backgroundAlerts";
    import { checkForUpdate as checkUpdateInfo, downloadAndInstall, autoCheckOnOpen, getLatestApkUrl, type UpdateInfo } from "../utils/autoUpdate";
    import { getChangelogFor, hasSeenChangelog, markChangelogSeen } from "../utils/changelog";
    import { Capacitor } from "@capacitor/core";
    import { notify } from "../utils/notify";
    import { LocalNotifications } from "@capacitor/local-notifications";

    const lang = document.documentElement.getAttribute('data-lang') || 'es';
    const t = getTranslations(lang);

    // Helper function to send notifications on both desktop and mobile (Android/Chrome ready)
    // Función auxiliar para enviar notificaciones en escritorio y móvil (lista para Android/Chrome)
    // Unified notification sender — native Android tray on Capacitor,
    // Service Worker / window.Notification on web.
    // Emisor unificado — bandeja nativa de Android en Capacitor,
    // Service Worker / window.Notification en web.
    async function sendNotification(title: string, options: any = {}) {
        await notify(title, options.body || '', { silent: !!options.silent });
    }

    // Show persistent background tracking notification
    // Mostrar la notificación persistente de seguimiento en segundo plano
    function showBackgroundNotification() {
        const title = lang === 'en' ? 'Coruña Bus - Active tracking' : 'Coruña Bus - Seguimiento activo';
        const bodyText = lang === 'en' ? 'The app will stay active in the background to alert you about your stops.' : 'La app se mantendrá activa en segundo plano para avisarte de tus paradas.';
        if (isNativePlatform()) {
            // Persistent, silent native notification (id 424243, tagged for later dismissal)
            // Notificación nativa persistente y silenciosa (id 424243, marcada para poder cerrarla)
            LocalNotifications.schedule({
                notifications: [{
                    id: 424243,
                    title,
                    body: bodyText,
                    channelId: 'buscoruna-alerts',
                    schedule: { at: new Date(Date.now() + 50) },
                    ongoing: true,
                    silent: true,
                    actionTypeId: '',
                    extra: { source: 'buscoruna-bg' },
                } as any],
            }).catch(() => {});
            return;
        }
        sendNotification(title, {
            body: bodyText,
            tag: "tracking-bg",
            silent: true,
            icon: "/logo.png",
            badge: "/logo.png",
            requireInteraction: true
        });
    }

    // Close persistent background tracking notification
    // Cerrar la notificación de seguimiento en segundo plano
    function closeBackgroundNotification() {
        if (isNativePlatform()) {
            // Dismiss the persistent tracking notification on native
            // Descartar la notificación persistente en nativo
            LocalNotifications.getDeliveredNotifications().then((res: any) => {
                const ids = (res.notifications || [])
                    .filter((n: any) => n.extra?.source === 'buscoruna-bg')
                    .map((n: any) => n.id);
                if (ids.length) LocalNotifications.removeDeliveredNotifications({ notifications: ids });
            }).catch(() => {});
            return;
        }
        if ("serviceWorker" in navigator && Notification.permission === "granted") {
            navigator.serviceWorker.ready.then((registration) => {
                registration.getNotifications({ tag: "tracking-bg" }).then((notifications) => {
                    notifications.forEach(notification => notification.close());
                });
            });
        }
    }

    const globalLoader = document.getElementById("global-api-loader");

    function checkInitialLoading() {
        if (isApiLoading()) {
            globalLoader?.classList.add("active");
        }
    }

    window.addEventListener("api-loading-start", () => {
        globalLoader?.classList.add("active");
    });
    window.addEventListener("api-loading-end", () => {
        globalLoader?.classList.remove("active");
    });

    // Initialize state
    checkInitialLoading();

    // Check for app updates (native build only)
    // Comprobar actualizaciones de la app (solo build nativo)
    autoCheckOnOpen();

    // Show the changelog once per new app version (native build only)
    // Mostrar el changelog una vez por versión nueva (solo build nativo)
    (async () => {
        try {
            if (!isNativePlatform()) return;
            const App = (Capacitor as any).Plugins?.App;
            if (!App?.getInfo) return;
            const info = await App.getInfo();
            const entry = getChangelogFor(info.version);
            if (!entry || hasSeenChangelog(info.version)) return;

            const modal = document.getElementById('changelog-modal');
            const titleEl = document.getElementById('changelog-title');
            const listEl = document.getElementById('changelog-items');
            if (!modal || !listEl) return;

            titleEl && (titleEl.textContent = `${t.changelogTitle} · v${entry.version}`);
            listEl.innerHTML = entry.items.map(i => `<li>${i}</li>`).join('');
            modal.style.display = 'flex';

            const close = () => {
                modal.style.display = 'none';
                markChangelogSeen(info.version);
            };
            document.getElementById('changelog-ok')?.addEventListener('click', close);
            document.getElementById('changelog-close')?.addEventListener('click', close);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) close();
            });
        } catch (e) {
            console.warn('[Changelog] failed to show', e);
        }
    })();

    function updateLastRefreshTime() {
        const el = document.getElementById("last-update");
        if (el) {
            const now = new Date();
            const label = lang === 'en' ? 'Updated' : 'Actualizado';
            const locale = lang === 'en' ? 'en-US' : 'es-ES';
            el.innerHTML = `${label}<br><strong>${now.toLocaleTimeString(locale, { hour: "2-digit", minute: "2-digit", second: "2-digit" })}</strong>`;
        }
    }

    const refreshBtn = document.getElementById("global-refresh-btn");
    refreshBtn?.addEventListener("click", () => {
        refreshBtn.classList.add("spinning");
        // Dispatch a global event that other components can listen to
        window.dispatchEvent(new CustomEvent("request-refresh"));

        setTimeout(() => {
            refreshBtn.classList.remove("spinning");
            updateLastRefreshTime();
        }, 1000);
    });

    // Tracking logic
    let trackingInterval: any = null;
    let isUpdating = false;
    // Bumped every time tracking is stopped. In-flight updates snapshot the
    // value when they start and discard their results if it changed meanwhile,
    // so "stop tracking" takes effect instantly instead of after the query.
    let trackingGeneration = 0;
    // Hard cap for a single UI update. Even if some awaited promise stalls, the
    // tracking loop and the "stop tracking" button must never lock up.
    const MAX_TRACKING_UPDATE_MS = 30000;

    // Cache + throttle for the expensive func=2 (full line info) ETA fallback.
    let lastLineInfoCheck = 0;
    let lineInfoCache = { foundInLine: false, stopsLeft: -1 };

    async function updateTrackingUI() {
        if (isUpdating) return;
        const info = tracking.get();
        const bar = document.getElementById("tracking-bar");
        if (!bar) return;

        if (!info) {
            bar.style.display = "none";
            if (trackingInterval) {
                clearInterval(trackingInterval);
                trackingInterval = null;
            }
            return;
        }

        isUpdating = true;
        const gen = trackingGeneration;
        bar.style.display = "block";
        document.getElementById("track-bus-id")!.textContent = info.busId;

        // Global circuit breaker open: pause network polling, keep the bar alive.
        if (isApiCooldownActive()) {
            document.getElementById("track-status")!.textContent =
                t.trackingConnectionError;
            document.getElementById("track-eta-val")!.textContent = "--";
            isUpdating = false;
            if (!trackingInterval) {
                trackingInterval = setInterval(updateTrackingUI, 60000);
            }
            return;
        }

        const catalog = storage.getCatalog();
        let destStopName = info.destinationStopId.toString();
        if (catalog) {
            const destStop = catalog.paradas[info.destinationStopId];
            destStopName = destStop?.nombre || destStopName;
        }
        
        // Dynamically update label depending on whether we are waiting or travelling
        // Actualizar dinámicamente el texto según si estamos esperando en la parada o de viaje
        const trackTitleEl = document.querySelector("#tracking-bar .tracking-text strong");
        if (trackTitleEl) {
            if (info.destinationStopId.toString() === info.originStopId.toString()) {
                trackTitleEl.innerHTML = `${t.trackingBarWaiting} <span id="track-dest-name">${destStopName}</span>`;
            } else {
                trackTitleEl.innerHTML = `${t.trackingBarDest} <span id="track-dest-name">${destStopName}</span>`;
            }
        } else {
            const destSpan = document.getElementById("track-dest-name");
            if (destSpan) destSpan.textContent = destStopName;
        }

        // Recalculate ETA
        // Watchdog: force-release isUpdating if this update ever runs past the
        // cap, so "stop tracking" and future refreshes can't be blocked forever.
        const watchdog = setTimeout(() => {
            isUpdating = false;
        }, MAX_TRACKING_UPDATE_MS);
        try {
            // Check ETA alert for the boarding/origin stop if enabled and not already triggered
            // Comprobar la alerta de ETA para la parada de origen si está activa y aún no se ha disparado
            const etaAlertEnabled = localStorage.getItem('buscoruna_eta_alert_enabled') !== 'false';
            const etaAlertTriggered = localStorage.getItem('buscoruna_eta_alert_triggered') === 'true';

            // The boarding-alert look-up and the destination ETA reply can run in
            // parallel: awaiting them sequentially would double the perceived
            // latency of the tracking bar.
            const originAlertCheck = (async () => {
                if (!(etaAlertEnabled && !etaAlertTriggered && info.originStopId)) return;
                try {
                    const originData = await API.getStopArrivals(info.originStopId);
                    if (originData && originData.resultado === "OK" && originData.buses && Array.isArray(originData.buses.lineas)) {
                        const lineInfo = originData.buses.lineas.find(
                            (bl: any) => bl.linea.toString() === info.lineId.toString()
                        );
                        if (lineInfo && Array.isArray(lineInfo.buses)) {
                            const b = lineInfo.buses.find(
                                (bus: any) => bus.bus && bus.bus.toString() === info.busId.toString()
                            );
                            if (b) {
                                let waitTime = typeof b.tiempo === "number" ? b.tiempo : parseInt(b.tiempo);
                                if (!isNaN(waitTime)) {
                                    const threshold = parseInt(localStorage.getItem('buscoruna_eta_alert_threshold') || '2');
                                    if (waitTime <= threshold && gen === trackingGeneration && tracking.get()) {
                                        // Trigger arrival alert!
                                        // Disparar aviso de llegada
                                        localStorage.setItem('buscoruna_eta_alert_triggered', 'true');
                                        
                                        // Send system notification (compatible with Android/Chrome)
                                        // Enviar notificación del sistema (compatible con Android/Chrome)
                                        const notifyTitle = lang === 'en' ? '🚌 Your bus is arriving!' : '🚌 ¡Tu autobús está llegando!';
                                        const notifyBody = lang === 'en' 
                                            ? `Bus ${info.busId} will arrive at your origin stop in ${waitTime} min. Board the bus!`
                                            : `El bus ${info.busId} llegará a tu parada de origen en ${waitTime} min. ¡Sube al bus!`;
                                        sendNotification(notifyTitle, {
                                            body: notifyBody,
                                            requireInteraction: true,
                                            icon: "/logo.png",
                                            badge: "/logo.png"
                                        });

                                        // Play sound and vibration FIRST, before any UI, so the user hears it immediately.
                                        // Reproducir sonido y vibración PRIMERO, antes de cualquier UI, para escucharlo al instante.
                                        if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
                                        try {
                                            const context = new (window.AudioContext || (window as any).webkitAudioContext)();
                                            if (context.state === 'suspended') await context.resume();
                                            const osc = context.createOscillator();
                                            osc.type = "sine";
                                            osc.frequency.setValueAtTime(523.25, context.currentTime); // C5 note
                                            osc.connect(context.destination);
                                            osc.start();
                                            osc.stop(context.currentTime + 0.6);
                                        } catch (e) {}

                                        // Non-blocking in-app banner (replaces blocking alert() which delayed the sound).
                                        // Banner no bloqueante (sustituye al alert() bloqueante que retrasaba el sonido).
                                        const alertText = lang === 'en'
                                            ? `🔔 Arrival alert! Your bus (Bus ${info.busId}) will arrive in ${waitTime} min.`
                                            : `🔔 ¡Aviso de llegada! Tu autobús (Bus ${info.busId}) llegará en ${waitTime} min.`;
                                        inAppAlert(alertText, { durationMs: 10000 });
                                    }
                                }
                            }
                        }
                    }
                } catch (etaErr) {
                    console.warn("Failed to check boarding ETA alert", etaErr);
                }
            })();

            // Step 1: Try getting arrivals at the destination stop
            const data = await API.getStopArrivals(info.destinationStopId);
            await originAlertCheck;

            // The user may have stopped tracking while we were waiting: bail out
            // without touching the UI.
            if (gen !== trackingGeneration || !tracking.get()) return;
            let busFoundAtStop = false;
            let targetBus: any = null;

            if (
                data &&
                data.resultado === "OK" &&
                data.buses &&
                Array.isArray(data.buses.lineas)
            ) {
                for (const l of data.buses.lineas) {
                    if (!Array.isArray(l.buses)) continue;
                    const b = l.buses.find(
                        (bus: any) =>
                            bus.bus &&
                            bus.bus.toString() === info.busId.toString(),
                    );
                    if (b) {
                        targetBus = b;
                        busFoundAtStop = true;
                        break;
                    }
                }
            }

            if (busFoundAtStop && targetBus) {
                let time =
                    typeof targetBus.tiempo === "number"
                        ? targetBus.tiempo
                        : parseInt(targetBus.tiempo);
                if (isNaN(time)) time = 0; // Fallback for ">>>", "PRX", etc.

                document.getElementById("track-eta-val")!.textContent =
                    time.toString();
                const arrivalTime = new Date(Date.now() + time * 60000);
                let timeStr = "--:--";
                try {
                    timeStr = arrivalTime.toLocaleTimeString(lang === 'en' ? 'en-US' : 'es-ES', {
                        hour: "2-digit",
                        minute: "2-digit",
                    });
                } catch (e) {
                    /* ignore invalid date */
                }

                document.getElementById("track-status")!.textContent =
                    `${t.trackingArrival}: ${timeStr}`;
                if (time === 0) {
                    if (info.destinationStopId.toString() === info.originStopId.toString()) {
                        document.getElementById("track-status")!.textContent =
                            t.trackingArrivingStop;
                    } else {
                        document.getElementById("track-status")!.textContent =
                            t.trackingArrivingDest;
                    }
                }
            } else {
                // Step 2: Fallback - Check full line info (func=2)
                // Throttled: only hit this expensive endpoint once per minute,
                // reuse the cached stops-left in between.
                let foundInLine = lineInfoCache.foundInLine;
                let stopsLeft = lineInfoCache.stopsLeft;
                const lineInfoStale = Date.now() - lastLineInfoCheck >= 60000;

                if (lineInfoStale) {
                    lastLineInfoCheck = Date.now();
                    lineInfoCache.foundInLine = false;
                    lineInfoCache.stopsLeft = -1;

                    try {
                        const lineData = await API.getLineInfo(info.lineId);

                        if (lineData && lineData.paradas && catalog) {
                            // Normalize lineData paradas into a flat list of stops with their buses
                            const stopsWithBuses = [];
                            if (Array.isArray(lineData.paradas)) {
                                for (const dir of lineData.paradas) {
                                    if (Array.isArray(dir.paradas)) {
                                        for (const p of dir.paradas) {
                                            if (
                                                Array.isArray(p.buses) &&
                                                p.buses.some(
                                                    (b: any) =>
                                                        b.bus &&
                                                        b.bus.toString() ===
                                                            info.busId.toString(),
                                                )
                                            ) {
                                                stopsWithBuses.push(
                                                    parseInt(p.id.toString()),
                                                );
                                            }
                                        }
                                    }
                                }
                            }

                            if (stopsWithBuses.length > 0) {
                                const busAtStopId = stopsWithBuses[0];
                                const targetDestIdNum = parseInt(
                                    info.destinationStopId.toString(),
                                );

                                const line = catalog.actualizacion.lineas.find(
                                    (l: any) =>
                                        l.id.toString() === info.lineId.toString(),
                                );
                                if (line && Array.isArray(line.rutas)) {
                                    for (const route of line.rutas) {
                                        if (!Array.isArray(route.paradas)) continue;
                                        const routeParadas = route.paradas.map((p) =>
                                            parseInt(p.toString()),
                                        );
                                        const bIdx = routeParadas.indexOf(busAtStopId);
                                        const dIdx =
                                            routeParadas.indexOf(targetDestIdNum);

                                        if (
                                            bIdx !== -1 &&
                                            dIdx !== -1 &&
                                            bIdx <= dIdx
                                        ) {
                                            stopsLeft = dIdx - bIdx;
                                            foundInLine = true;
                                            lineInfoCache.foundInLine = true;
                                            lineInfoCache.stopsLeft = dIdx - bIdx;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    } catch (lineErr) {
                        // Ignore transient failures on the throttled fallback.
                        lineInfoCache.foundInLine = false;
                    }
                }

                // Tracking may have been stopped while the fallback was running.
                if (gen !== trackingGeneration || !tracking.get()) return;

                if (foundInLine) {
                    const estimatedMins = Math.max(
                        1,
                        Math.round(stopsLeft * 2.5),
                    );
                    document.getElementById("track-eta-val")!.textContent =
                        estimatedMins.toString();
                    document.getElementById("track-status")!.textContent =
                        `~${stopsLeft} ${t.trackingStopsAway}`;
                } else {
                    document.getElementById("track-status")!.textContent =
                        t.trackingSearchingBus;
                    document.getElementById("track-eta-val")!.textContent =
                        "--";
                }
            }
        } catch (err) {
            console.warn("Failed to update tracking ETA", err);
            document.getElementById("track-status")!.textContent =
                t.trackingConnectionError;
        } finally {
            clearTimeout(watchdog);
            isUpdating = false;
        }

        if (!trackingInterval && tracking.get()) {
            trackingInterval = setInterval(updateTrackingUI, 60000);
        }
    }

    // Initialize tracking UI immediately on load
    if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
    ) {
        updateTrackingUI();
    } else {
        window.addEventListener("DOMContentLoaded", updateTrackingUI);
    }

    // Update when tracking is updated globally
    window.addEventListener("tracking-updated", () => {
        updateTrackingUI();
    });

    document.getElementById("stop-tracking")?.addEventListener("click", () => {
        // Take effect immediately: bump the generation so any in-flight update
        // discards its results, hide the bar and kill the poller right away.
        trackingGeneration++;
        const bar = document.getElementById("tracking-bar");
        if (bar) bar.style.display = "none";
        if (trackingInterval) {
            clearInterval(trackingInterval);
            trackingInterval = null;
        }
        tracking.clear();
    });

    window.addEventListener("request-refresh", () => {
        updateTrackingUI();
    });

    // Modal logic for fallback
    document
        .getElementById("edit-tracking-dest")
        ?.addEventListener("click", async () => {
            const info = tracking.get();
            if (!info) return;

            const modal = document.getElementById("global-destination-modal")!;
            const list = document.getElementById("global-stops-list-modal")!;
            const lineNameEl = document.getElementById("modal-line-name")!;

            modal.style.display = "flex";
            list.innerHTML = '<div class="small">Cargando paradas...</div>';

            try {
                const catalog = storage.getCatalog();
                const lineData = await API.getLineInfo(info.lineId);

                if (lineData && Array.isArray(lineData.paradas) && catalog) {
                    lineNameEl.textContent = info.lineId.toString();
                    const line = catalog.actualizacion.lineas.find(
                        (l: any) => l.id.toString() === info.lineId.toString(),
                    );
                    if (line) lineNameEl.textContent = line.lin_comer;

                    // Find current bus position to filter upcoming stops
                    let currentBusStopId: number | null = null;
                    for (const dir of lineData.paradas) {
                        if (Array.isArray(dir.paradas)) {
                            for (const p of dir.paradas) {
                                if (
                                    Array.isArray(p.buses) &&
                                    p.buses.some(
                                        (b: any) =>
                                            b.bus &&
                                            b.bus.toString() ===
                                                info.busId.toString(),
                                    )
                                ) {
                                    currentBusStopId = parseInt(
                                        p.id.toString(),
                                    );
                                    break;
                                }
                            }
                        }
                        if (currentBusStopId) break;
                    }

                    // Get all stops on the line (from catalog for names)
                    const allStopIds: number[] = [];
                    if (line) {
                        line.rutas.forEach((r: any) => {
                            r.paradas.forEach((sId: any) => {
                                if (!allStopIds.includes(parseInt(sId)))
                                    allStopIds.push(parseInt(sId));
                            });
                        });
                    }

                    // Filter: if we know where the bus is, only show stops after it.
                    // For simplicity, if we don't know, show all.
                    list.innerHTML = allStopIds
                        .map((sId) => {
                            const s = catalog.paradas[sId];
                            return `
            <div class="modal-list-item" data-stop="${sId}">
              <strong>${s?.nombre || sId}</strong>
              <small>Parada ${sId}</small>
            </div>
          `;
                        })
                        .join("");

                    list.querySelectorAll(".modal-list-item").forEach(
                        (item) => {
                            item.addEventListener("click", () => {
                                const newDestId = parseInt(
                                    item.getAttribute("data-stop")!,
                                );
                                const currentInfo = tracking.get();
                                if (currentInfo) {
                                    tracking.set({
                                        ...currentInfo,
                                        destinationStopId: newDestId,
                                    });
                                }
                                modal.style.display = "none";
                            });
                        },
                    );
                } else {
                    list.innerHTML =
                        '<div class="small">No se pudieron cargar las paradas de esta línea.</div>';
                }
            } catch (err) {
                list.innerHTML =
                    '<div class="small">Error al conectar con el servidor.</div>';
            }
        });

    document
        .getElementById("close-global-modal")
        ?.addEventListener("click", () => {
            document.getElementById("global-destination-modal")!.style.display =
                "none";
        });

    // Auto refresh every 60 seconds
    setInterval(() => {
        window.dispatchEvent(new CustomEvent("request-refresh"));
        updateLastRefreshTime();
    }, 60000);

    // Initial time
    updateLastRefreshTime();

    // Share functionality
    document
        .getElementById("share-app-btn")
        ?.addEventListener("click", async () => {
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: "Coruña Bus",
                        text: "¡Mira esta app para moverte por Coruña en bus!",
                        url: window.location.origin,
                    });
                } catch (err) {
                    console.error("Error sharing:", err);
                }
            } else {
                // Fallback: copy to clipboard
                navigator.clipboard.writeText(window.location.origin);
                alert(
                    "Enlace copiado al portapapeles. ¡Gracias por compartir!",
                );
            }
        });

    // GPS Alert Stop Warning & Background Keep-Awake features (bilingual comments)
    // Funcionalidad de aviso de parada por GPS, aviso de llegada de bus y ejecución en segundo plano
    let gpsInterval: any = null;
    let audioContext: AudioContext | null = null;
    let silenceNode: GainNode | null = null;

    function getDistance(lat1: number, lon1: number, lat2: number, lon2: number) {
        const R = 6371000; // meters
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    // Resolve the stop immediately before the destination stop in the route.
    // The destination alone disambiguates the direction: among the routes that
    // contain it, pick the one where it sits closest to the end (that is the
    // direction the bus is travelling in) and return its predecessor.
    // Obtener la parada inmediatamente anterior a la parada de destino en la
    // ruta. El destino basta para saber el sentido: de las rutas que lo
    // contienen, elige la que lo tenga más cerca del final (el sentido real
    // del bus) y devuelve la parada anterior.
    function getPreviousStop(lineId: number, destId: number, catalog: any) {
        const line = catalog.actualizacion.lineas.find(
            (l: any) => l.id.toString() === lineId.toString()
        );
        if (!line || !Array.isArray(line.rutas)) return null;

        const sDestId = destId.toString();

        let bestStopId: any = null;
        let bestScore = Infinity;
        for (const route of line.rutas) {
            if (!Array.isArray(route.paradas)) continue;
            const dIdx = route.paradas.findIndex((p: any) => p.toString() === sDestId);
            if (dIdx <= 0) continue;
            const score = route.paradas.length - dIdx; // lower = dest nearer the end
            if (score < bestScore) {
                bestScore = score;
                bestStopId = route.paradas[dIdx - 1];
            }
        }
        return bestStopId ? catalog.paradas[bestStopId] : null;
    }

    // Main interval check function to check GPS location against route stops
    // Función de verificación periódica del GPS contra las paradas de la ruta
    function checkGPSAlert() {
        const info = tracking.get();
        if (!info) {
            stopGPSMonitor();
            return;
        }

        if (localStorage.getItem('buscoruna_gps_alert_triggered') === 'true') {
            return; // Already notified for this journey
        }

        const catalog = storage.getCatalog();
        if (!catalog) return;

        const destStop = catalog.paradas[info.destinationStopId];
        const originStop = catalog.paradas[info.originStopId];
        if (!destStop) return;

        // Only useful while the user is riding towards a real destination. The
        // "waiting at the stop" case (origin == destination, arrival alarm) must
        // not fire the get-off alert.
        const isRiding = info.originStopId.toString() !== info.destinationStopId.toString();
        if (!isRiding) return;

        const prevStop = getPreviousStop(info.lineId, info.destinationStopId, catalog);

        navigator.geolocation.getCurrentPosition((position) => {
            const userLat = position.coords.latitude;
            const userLon = position.coords.longitude;

            const distToDest = getDistance(userLat, userLon, destStop.posy, destStop.posx);

            let atPreviousStop = false;
            let passedPreviousStop = false;
            let distPrevToDest = Infinity;
            if (prevStop) {
                const distToPrev = getDistance(userLat, userLon, prevStop.posy, prevStop.posx);
                distPrevToDest = getDistance(prevStop.posy, prevStop.posx, destStop.posy, destStop.posx);

                // At the previous stop (< 120m) or already closer to destination
                // than the previous stop (we passed it).
                atPreviousStop = distToPrev < 120;
                passedPreviousStop = distToDest < Math.min(350, distPrevToDest * 0.85);
            }
            // Fallback: if the route couldn't be resolved, still warn when the
            // user is physically close to the destination stop.
            const approachingDest = distToDest < 150;

            console.log(`[GPS Alert] distToDest: ${distToDest.toFixed(1)}m, atPrev: ${atPreviousStop}, passedPrev: ${passedPreviousStop}`);

            if (atPreviousStop || passedPreviousStop || approachingDest) {
                // Trigger warning!
                // Activar aviso
                localStorage.setItem('buscoruna_gps_alert_triggered', 'true');
                
                // Show modal overlay alert
                // Mostrar alerta emergente en pantalla
                const alertPopup = document.getElementById("gps-alert-popup");
                const alertDestName = document.getElementById("gps-alert-dest-name");
                if (alertDestName) alertDestName.textContent = destStop.nombre;
                if (alertPopup) alertPopup.style.display = "flex";

                // Vibrate device if supported
                // Vibrar el dispositivo si está soportado
                if (navigator.vibrate) {
                    navigator.vibrate([300, 100, 300, 100, 300]);
                }
                
                // Play oscillator beep sound
                // Emitir un pitido de advertencia por el altavoz
                try {
                    const context = new (window.AudioContext || (window as any).webkitAudioContext)();
                    const osc = context.createOscillator();
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(880, context.currentTime);
                    osc.connect(context.destination);
                    osc.start();
                    osc.stop(context.currentTime + 0.5);
                } catch (soundErr) {
                    console.warn("Could not play warning sound", soundErr);
                }

                // Send background push/system notification if permission granted (compatible with Android/Chrome)
                // Enviar notificación del sistema si los permisos han sido concedidos (compatible con Android/Chrome)
                const gpsTitle = lang === 'en' ? '⚠️ PRESS THE STOP BUTTON!' : '⚠️ ¡PULSA EL BOTÓN DE PARADA!';
                const gpsBodyText = lang === 'en'
                    ? `You are approaching your destination: ${destStop.nombre}. Alert the driver!`
                    : `Te aproximas a tu destino: ${destStop.nombre}. ¡Avisa al conductor!`;
                sendNotification(gpsTitle, {
                    body: gpsBodyText,
                    requireInteraction: true,
                    icon: "/logo.png",
                    badge: "/logo.png"
                });
            }
        }, (geoErr) => {
            console.warn("[GPS Alert] Geolocation failed", geoErr);
        }, {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 0
        });
    }

    // --- Wake Lock + Audio + Media Session (like YouTube) ---
    // Mantener la pantalla encendida y priorizar el proceso en Android
    let wakeLock: WakeLockSentinel | null = null;

    async function acquireWakeLock() {
        if ('wakeLock' in navigator) {
            try {
                wakeLock = await navigator.wakeLock.request('screen');
                wakeLock.addEventListener('release', () => {
                    console.log("[WakeLock] Released");
                });
                console.log("[WakeLock] Acquired");
            } catch (err) {
                console.warn("[WakeLock] Failed to acquire", err);
            }
        }
    }

    function releaseWakeLock() {
        if (wakeLock) {
            wakeLock.release();
            wakeLock = null;
            console.log("[WakeLock] Released manually");
        }
    }

    // Re-acquire wake lock if the page becomes visible again (user switches back)
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && wakeLock === null) {
            // If keep-awake is enabled and we lost the lock, re-acquire
            if (localStorage.getItem('buscoruna_bg_keep_awake') === 'true') {
                acquireWakeLock();
            }
        }
    });

    function startSilencePlayback() {
        if (audioContext) return;
        try {
            // 1) Screen Wake Lock — keep screen on
            acquireWakeLock();

            // 2) Media Session API — show "playing" in notification shade (like YouTube)
            if ('mediaSession' in navigator) {
                navigator.mediaSession.metadata = new MediaMetadata({
                    title: 'Coruña Bus',
                    artist: 'Seguimiento activo',
                    artwork: [{ src: '/logo.png', sizes: '512x512', type: 'image/png' }],
                });
                navigator.mediaSession.playbackState = 'playing';
            }

            // 3) Silent audio loop — helps Chrome keep the tab alive
            audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
            const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 2, audioContext.sampleRate);
            const source = audioContext.createBufferSource();
            source.buffer = buffer;
            source.loop = true;
            
            silenceNode = audioContext.createGain();
            silenceNode.gain.setValueAtTime(0, audioContext.currentTime); // 0 volume
            
            source.connect(silenceNode);
            silenceNode.connect(audioContext.destination);
            source.start();
            console.log("[Background] Silence loop started successfully.");
            
            // Show persistent background tracking notification
            showBackgroundNotification();
        } catch (err) {
            console.warn("Failed to initiate silence background loop", err);
        }
    }

    function stopSilencePlayback() {
        // Release Wake Lock
        releaseWakeLock();

        // Reset Media Session
        if ('mediaSession' in navigator) {
            navigator.mediaSession.playbackState = 'none';
        }

        // Close audio context
        if (audioContext) {
            try {
                audioContext.close();
            } catch (e) {}
            audioContext = null;
            silenceNode = null;
        }
        closeBackgroundNotification();
    }

    function startGPSMonitor() {
        if (gpsInterval) clearInterval(gpsInterval);
        gpsInterval = setInterval(checkGPSAlert, 10000); // Check location every 10s
        checkGPSAlert();
    }

    function stopGPSMonitor() {
        if (gpsInterval) {
            clearInterval(gpsInterval);
            gpsInterval = null;
        }
    }

    // Apply alert configurations (starts/stops monitors and background loops)
    // Aplicar las configuraciones de alertas (iniciar/detener monitores y bucles)
    function applySettings() {
        const info = tracking.get();
        
        // GPS alert warning
        const gpsEnabled = localStorage.getItem('buscoruna_gps_alert_enabled') !== 'false';
        if (gpsEnabled && info) {
            startGPSMonitor();
        } else {
            stopGPSMonitor();
        }

        // Background keep-awake
        const keepAwakeEnabled = localStorage.getItem('buscoruna_bg_keep_awake') === 'true';
        if (keepAwakeEnabled && info) {
            startSilencePlayback();
        } else {
            stopSilencePlayback();
        }
    }

    // Settings Modal UI Events
    // Eventos de la Interfaz del Modal de Ajustes
    const settingsModal = document.getElementById("settings-modal");
    
    // Open settings button in header
    // Abrir modal de ajustes al pulsar el botón del header
    const openSettings = async () => {
        const gpsAlertInput = document.getElementById("settings-enable-gps-alert") as HTMLInputElement;
        const etaAlertInput = document.getElementById("settings-enable-eta-alert") as HTMLInputElement;
        const etaThresholdSelect = document.getElementById("settings-eta-threshold") as HTMLSelectElement;
        const keepAwakeInput = document.getElementById("settings-enable-bg-keep-awake") as HTMLInputElement;
        const langSelect = document.getElementById("settings-lang-select") as HTMLSelectElement;
        
        if (gpsAlertInput) gpsAlertInput.checked = localStorage.getItem('buscoruna_gps_alert_enabled') !== 'false';

        // On native, the background alert replaces the web-only ETA flag
        // En nativo, el aviso en segundo plano sustituye al flag solo-web
        const bgCfg = await getBgConfig();
        const native = isNativePlatform();
        if (etaAlertInput) etaAlertInput.checked = native ? bgCfg.enabled : localStorage.getItem('buscoruna_eta_alert_enabled') !== 'false';
        if (etaThresholdSelect) etaThresholdSelect.value = localStorage.getItem('buscoruna_eta_alert_threshold') || (native ? String(bgCfg.leadMinutes) : '2');
        if (keepAwakeInput) keepAwakeInput.checked = localStorage.getItem('buscoruna_bg_keep_awake') === 'true';
        if (langSelect) langSelect.value = document.documentElement.getAttribute('data-lang') || 'es';

        // Show the appropriate warning depending on platform
        // Mostrar la advertencia adecuada según la plataforma
        const warnWeb = document.getElementById('settings-eta-warn-web');
        const warnNative = document.getElementById('settings-eta-warn-native');
        if (warnWeb) warnWeb.style.display = native ? 'none' : '';
        if (warnNative) warnNative.style.display = native ? '' : 'none';
        
        if (settingsModal) {
            settingsModal.style.display = "flex";
        }
    };

    const closeSettings = () => {
        if (settingsModal) {
            settingsModal.style.display = "none";
        }
    };

    document.getElementById("open-settings-btn")?.addEventListener("click", openSettings);

    // Close settings button
    // Cerrar modal de ajustes al pulsar X
    document.getElementById("close-settings")?.addEventListener("click", closeSettings);

    // Test notification button
    // Botón de prueba de notificaciones
    document.getElementById("btn-test-notification")?.addEventListener("click", () => {
        const testTitle = lang === 'en' ? '🚌 Coruña Bus Test' : '🚌 Prueba de Coruña Bus';
        const testBody = lang === 'en' 
            ? 'It works! Notifications are correctly configured on your device.' 
            : '¡Funciona! Las notificaciones están bien configuradas en tu dispositivo.';
        const testDenied = lang === 'en'
            ? '⚠️ Notification permission denied. Enable it in your browser settings.'
            : '⚠️ Permiso de notificaciones denegado. Actívalo en los ajustes de tu navegador.';

        if (Notification.permission !== "granted") {
            Notification.requestPermission().then((perm) => {
                if (perm === "granted") {
                    sendNotification(testTitle, {
                        body: testBody,
                        icon: "/logo.png",
                        badge: "/logo.png"
                    });
                } else {
                    alert(testDenied);
                }
            });
        } else {
            sendNotification(testTitle, {
                body: testBody,
                icon: "/logo.png",
                badge: "/logo.png"
            });
        }
    });

    // App update & Android APK download UI
    // Interfaz de actualización de la app y descarga de APK para Android
    const updateItem = document.getElementById('settings-update-item');
    const androidDownloadItem = document.getElementById('settings-android-download-item');
    const webBgNotice = document.getElementById('settings-web-bg-notice');
    const webTrackingHint = document.getElementById('web-tracking-hint');
    const footerApkCard = document.getElementById('android-apk-footer-card');
    const isAndroidDevice = /Android/i.test(navigator.userAgent);
    const isNative = isNativePlatform();

    if (isNative) {
        if (updateItem) updateItem.style.display = '';
        if (androidDownloadItem) androidDownloadItem.style.display = 'none';
        if (webBgNotice) webBgNotice.style.display = 'none';
        if (webTrackingHint) webTrackingHint.style.display = 'none';
        if (footerApkCard) footerApkCard.style.display = 'none';
    } else {
        // On Web: show web background notice in settings and hint in tracking bar
        // En Web: mostrar aviso de limitaciones de segundo plano y enlace a la app
        if (webBgNotice) webBgNotice.style.display = 'flex';
        if (webTrackingHint) webTrackingHint.style.display = 'block';

        getLatestApkUrl().then((apkUrl) => {
            const settingsNoticeBtn = document.getElementById('settings-web-notice-apk-btn') as HTMLAnchorElement | null;
            if (settingsNoticeBtn) settingsNoticeBtn.href = apkUrl;
            const trackBarApkLink = document.getElementById('track-bar-apk-link') as HTMLAnchorElement | null;
            if (trackBarApkLink) trackBarApkLink.href = apkUrl;
            const settingsBtn = document.getElementById('settings-download-apk-btn') as HTMLAnchorElement | null;
            if (settingsBtn) settingsBtn.href = apkUrl;
            const footerBtn = document.getElementById('footer-download-apk-btn') as HTMLAnchorElement | null;
            if (footerBtn) footerBtn.href = apkUrl;
        }).catch(() => {});

        if (isAndroidDevice) {
            // On Android Web / PWA: Show download app cards & buttons
            if (updateItem) updateItem.style.display = 'none';
            if (androidDownloadItem) androidDownloadItem.style.display = '';
            if (footerApkCard) footerApkCard.style.display = 'flex';
        } else {
            // On non-Android Web: show informational note
            if (updateItem) {
                updateItem.style.display = '';
                const statusEl = document.getElementById('settings-update-status');
                if (statusEl) {
                    statusEl.style.display = '';
                    statusEl.textContent = t.settingsUpdateWebNote;
                }
                const checkBtn = document.getElementById('btn-check-update');
                if (checkBtn) checkBtn.style.display = 'none';
            }
            if (androidDownloadItem) androidDownloadItem.style.display = 'none';
            if (footerApkCard) footerApkCard.style.display = 'none';
        }
    }

    let lastUpdateInfo: UpdateInfo | null = null;

    document.getElementById('btn-check-update')?.addEventListener('click', async () => {
        const statusEl = document.getElementById('settings-update-status')!;
        const btn = document.getElementById('btn-check-update') as HTMLButtonElement;
        const progWrap = document.getElementById('update-progress-wrap')!;
        const progFill = document.getElementById('update-progress-fill')!;
        const progText = document.getElementById('update-progress-text')!;

        btn.disabled = true;
        btn.textContent = t.settingsUpdateChecking;
        statusEl.style.display = '';
        progWrap.style.display = 'none';

        try {
            const info = await checkUpdateInfo();
            lastUpdateInfo = info;
            if (!info.available) {
                statusEl.textContent = t.settingsUpdateUpToDate;
                btn.disabled = false;
                btn.textContent = t.settingsUpdateCheck;
                return;
            }

            statusEl.textContent = t.settingsUpdateAvailable.replace('{v}', info.versionName);

            // Turn the check button into the download button
            // Convertir el botón de comprobar en botón de descarga
            btn.disabled = false;
            btn.textContent = t.settingsUpdateDownload;
            btn.onclick = async () => {
                if (!lastUpdateInfo?.apkUrl) return;
                btn.disabled = true;
                progWrap.style.display = 'flex';
                progFill.style.width = '0%';
                progText.textContent = '0%';
                try {
                    await downloadAndInstall(lastUpdateInfo.apkUrl, (pct) => {
                        progFill.style.width = `${pct}%`;
                        progText.textContent = `${pct}%`;
                        if (pct >= 100) {
                            statusEl.textContent = t.settingsUpdateInstalling;
                        }
                    });
                } catch (err) {
                    console.error('[AutoUpdate] install failed', err);
                    statusEl.textContent = t.settingsUpdateError;
                    btn.disabled = false;
                    btn.textContent = t.settingsUpdateCheck;
                }
            };
        } catch (err) {
            console.error('[AutoUpdate] check failed', err);
            statusEl.textContent = t.settingsUpdateError;
            btn.disabled = false;
            btn.textContent = t.settingsUpdateCheck;
        }
    });

    // Save settings button
    // Guardar ajustes seleccionados por el usuario
    document.getElementById("btn-save-settings")?.addEventListener("click", async () => {
        const gpsAlertInput = document.getElementById("settings-enable-gps-alert") as HTMLInputElement;
        const etaAlertInput = document.getElementById("settings-enable-eta-alert") as HTMLInputElement;
        const etaThresholdSelect = document.getElementById("settings-eta-threshold") as HTMLSelectElement;
        const keepAwakeInput = document.getElementById("settings-enable-bg-keep-awake") as HTMLInputElement;
        const langSelect = document.getElementById("settings-lang-select") as HTMLSelectElement;

        const gpsEnabled = gpsAlertInput?.checked ? 'true' : 'false';
        const etaEnabled = etaAlertInput?.checked ? 'true' : 'false';
        const etaThreshold = etaThresholdSelect?.value || '0';
        const keepAwakeEnabled = keepAwakeInput?.checked ? 'true' : 'false';
        const selectedLang = langSelect?.value || 'es';
        const oldLang = document.documentElement.getAttribute('data-lang') || 'es';

        localStorage.setItem('buscoruna_gps_alert_enabled', gpsEnabled);
        localStorage.setItem('buscoruna_eta_alert_enabled', etaEnabled);
        localStorage.setItem('buscoruna_eta_alert_threshold', etaThreshold);
        localStorage.setItem('buscoruna_bg_keep_awake', keepAwakeEnabled);
        localStorage.setItem('buscoruna_lang', selectedLang);
        document.cookie = "buscoruna_lang=" + selectedLang + ";path=/;max-age=" + (60 * 60 * 24 * 365);

        // Sync the native background alert with the ETA setting + lead minutes
        // Sincronizar el aviso nativo en segundo plano con el ajuste ETA y los minutos de antelación
        const leadMinutes = parseInt(etaThreshold, 10) || 0;
        await setBgConfig({ enabled: etaAlertInput?.checked ?? false, leadMinutes });
        if (etaAlertInput?.checked) {
            const granted = await requestBgAlertPermission();
            if (granted) {
                startForegroundChecker(
                    (stopId) => API.getStopArrivals(stopId),
                    (title, body) => {
                        inAppAlert(`${title} ${body}`, { durationMs: 10000 });
                        if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
                    },
                );
            }
        } else {
            stopForegroundChecker();
        }

        // Ask for browser notification permissions if any alert checked.
        // Guarded: `Notification` doesn't exist in the native WebView and a
        // ReferenceError here would kill the handler before closing the modal
        // (making it look like settings "don't save").
        // Pedir permisos de notificación del navegador si hay alertas activas.
        // Protegido: `Notification` no existe en el WebView nativo y un
        // ReferenceError aquí mataría el handler antes de cerrar el modal
        // (pareciendo que los ajustes "no se guardan").
        if (gpsAlertInput?.checked || etaAlertInput?.checked || keepAwakeInput?.checked) {
            try {
                if (typeof Notification !== "undefined" && Notification.permission === "default") {
                    Notification.requestPermission();
                }
            } catch (e) {
                console.warn("Notification permission check unavailable", e);
            }
        }

        // The GPS get-off alert needs the geolocation permission: prompt for it
        // now so it doesn't silently fail later while riding.
        // La alerta GPS de bajada necesita permiso de geolocalización: pídelo
        // ahora para que no falle en silencio al ir en el autobús.
        if (gpsAlertInput?.checked) {
            try {
                const perms = (navigator as any).permissions;
                if (perms?.query) {
                    perms.query({ name: 'geolocation' }).then((s: any) => {
                        if (s.state === 'prompt') navigator.geolocation.getCurrentPosition(() => {});
                    }).catch(() => {});
                } else if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(() => {});
                }
            } catch (e) {
                console.warn("Could not request geolocation permission", e);
            }
        }

        applySettings();
        closeSettings();

        // Visible confirmation that settings were saved
        // Confirmación visible de que los ajustes se guardaron
        inAppAlert(lang === 'en' ? '✅ Settings saved' : '✅ Ajustes guardados', { durationMs: 3000 });

        if (selectedLang !== oldLang) {
            window.location.reload();
        }
    });

    // Close settings if clicked outside of the content container
    // Cerrar ajustes si se pulsa fuera de la tarjeta modal
    settingsModal?.addEventListener("click", (e) => {
        if (e.target === settingsModal) {
            closeSettings();
        }
    });

    // Bind popup close button click listener
    document.getElementById("btn-close-gps-alert")?.addEventListener("click", () => {
        const popup = document.getElementById("gps-alert-popup");
        if (popup) popup.style.display = "none";
    });

    // Reset alert trigger flags on new tracking/journey configuration
    // Reiniciar los avisos cuando cambia o finaliza el seguimiento
    window.addEventListener("tracking-updated", async (e: any) => {
        localStorage.removeItem('buscoruna_gps_alert_triggered');
        localStorage.removeItem('buscoruna_eta_alert_triggered');

        // Reset background-alert state and restart the foreground checker
        // Reiniciar el estado de aviso en segundo plano y relanzar el comprobador
        await resetAlertState(e.detail ?? null);
        const cfg = await getBgConfig();
        if (e.detail && cfg.enabled && (isNativePlatform() || await checkBgAlertPermission())) {
            startForegroundChecker(
                (stopId) => API.getStopArrivals(stopId),
                (title, body) => {
                    inAppAlert(`${title} ${body}`, { durationMs: 10000 });
                    if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
                },
            );
        } else {
            stopForegroundChecker();
        }

        const info = e.detail;
        if (info) {
            if (isNativePlatform()) {
                const catalog = storage.getCatalog();
                const destStop = catalog?.paradas ? catalog.paradas[info.destinationStopId] : null;
                const originStop = catalog?.paradas ? catalog.paradas[info.originStopId] : null;
                const prevStop = catalog ? getPreviousStop(info.lineId, info.destinationStopId, catalog) : null;
                const threshold = parseInt(localStorage.getItem('buscoruna_eta_alert_threshold') || '2', 10);
                const etaEnabled = localStorage.getItem('buscoruna_eta_alert_enabled') !== 'false';
                const gpsEnabled = localStorage.getItem('buscoruna_gps_alert_enabled') !== 'false';

                startNativeBackgroundTracking({
                    busId: info.busId.toString(),
                    lineId: info.lineId.toString(),
                    originStopId: info.originStopId,
                    originStopName: originStop?.nombre || `Parada ${info.originStopId}`,
                    destinationStopId: info.destinationStopId,
                    destinationStopName: destStop?.nombre || `Parada ${info.destinationStopId}`,
                    destLat: destStop ? parseFloat(destStop.posy) : 0,
                    destLon: destStop ? parseFloat(destStop.posx) : 0,
                    prevLat: prevStop ? parseFloat(prevStop.posy) : 0,
                    prevLon: prevStop ? parseFloat(prevStop.posx) : 0,
                    leadMinutes: threshold,
                    etaAlertEnabled: etaEnabled,
                    gpsAlertEnabled: gpsEnabled,
                    lang: lang
                });
            }
            applySettings();
        } else {
            if (isNativePlatform()) {
                stopNativeBackgroundTracking();
            }
            stopGPSMonitor();
            stopSilencePlayback();
        }
    });

    // Initial load setup
    const initialInfo = tracking.get();
    if (initialInfo) {
        if (isNativePlatform()) {
            const catalog = storage.getCatalog();
            const destStop = catalog?.paradas ? catalog.paradas[initialInfo.destinationStopId] : null;
            const originStop = catalog?.paradas ? catalog.paradas[initialInfo.originStopId] : null;
            const prevStop = catalog ? getPreviousStop(initialInfo.lineId, initialInfo.destinationStopId, catalog) : null;
            const threshold = parseInt(localStorage.getItem('buscoruna_eta_alert_threshold') || '2', 10);
            const etaEnabled = localStorage.getItem('buscoruna_eta_alert_enabled') !== 'false';
            const gpsEnabled = localStorage.getItem('buscoruna_gps_alert_enabled') !== 'false';

            startNativeBackgroundTracking({
                busId: initialInfo.busId.toString(),
                lineId: initialInfo.lineId.toString(),
                originStopId: initialInfo.originStopId,
                originStopName: originStop?.nombre || `Parada ${initialInfo.originStopId}`,
                destinationStopId: initialInfo.destinationStopId,
                destinationStopName: destStop?.nombre || `Parada ${initialInfo.destinationStopId}`,
                destLat: destStop ? parseFloat(destStop.posy) : 0,
                destLon: destStop ? parseFloat(destStop.posx) : 0,
                prevLat: prevStop ? parseFloat(prevStop.posy) : 0,
                prevLon: prevStop ? parseFloat(prevStop.posx) : 0,
                leadMinutes: threshold,
                etaAlertEnabled: etaEnabled,
                gpsAlertEnabled: gpsEnabled,
                lang: lang
            });
        }
        applySettings();
    }

    // Highlight active nav item based on current pathname
    const currentPath = window.location.pathname;
    document.querySelectorAll('.bottom-nav .nav-item').forEach(item => {
        const href = item.getAttribute('href');
        if (href === currentPath || (href && href !== '/' && currentPath.startsWith(href))) {
            item.classList.add('active');
        } else if (href === '/' && (currentPath === '/' || currentPath === '')) {
            item.classList.add('active');
        } else {
            item.classList.remove('active');
        }
    });

    // First-time language selector UI Events
    const firstTimeLangModal = document.getElementById("first-time-lang-selector-modal");
    if (firstTimeLangModal) {
        const storedLang = localStorage.getItem("buscoruna_lang") || (document.cookie.match(/buscoruna_lang=([^;]+)/)?.[1]);
        if (!storedLang) {
            firstTimeLangModal.style.display = "flex";
        }
        const langBtns = firstTimeLangModal.querySelectorAll(".lang-btn");
        langBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                const selectedLang = btn.getAttribute("data-lang") || "es";
                localStorage.setItem("buscoruna_lang", selectedLang);
                document.cookie = "buscoruna_lang=" + selectedLang + ";path=/;max-age=" + (60 * 60 * 24 * 365);
                firstTimeLangModal.style.display = "none";
                window.location.reload();
            });
        });
    }
</script>
