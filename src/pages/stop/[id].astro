---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getTranslations } from '../../utils/i18n';

const lang = Astro.cookies.get('buscoruna_lang')?.value || 'es';
const t = getTranslations(lang);
---

<Layout title={`${t.stopDetailTitle} - Coruña Bus`}>
  <section class="stop-detail-page anim-stagger">
    <div id="stop-header" class="card anim-up">
      <div id="header-loading" class="loading-state" style="padding:0.6rem 0;">
        <div class="loading">{t.stopDetailLoading}</div>
        <div class="skeleton-stack" aria-hidden="true"><div class="skeleton skeleton-card" style="height:60px"></div></div>
      </div>
      <div id="header-real" style="display:none">
      <div class="header-main">
        <div class="stop-id-badge" id="display-stop-id">...</div>
        <h2 id="display-stop-name">{t.stopDetailLoading}</h2>
        <button id="favorite-btn" class="fav-btn">
          <div id="fav-icon-container">
            <Icon name="star-outline" />
          </div>
        </button>
      </div>
      <p id="display-stop-address" class="text-muted"></p>
      </div>
    </div>

    <div id="stop-map-container" class="map-container anim-up">
      <div id="stop-map" style="height: 250px; border-radius: 12px; z-index: 1;"></div>
      <div id="stop-map-loading" class="map-loading-overlay" style="display:none"><span>Consultando mapa…</span></div>
      <div class="map-actions">
        <button id="expand-stop-map" class="map-btn" title={t.mapExpand}>
          <Icon name="maximize" size={20} />
        </button>
        <button id="collapse-stop-map" class="map-btn" style="display: none;" title={t.mapCollapse}>
          <Icon name="minimize" size={20} />
        </button>
        <button id="street-view-btn" class="map-btn" title={t.streetViewBtn}>
          <Icon name="street-view" size={20} />
        </button>
        <button id="toggle-satellite" class="map-btn" title={t.stopDetailSatelliteView}>
          <Icon name="map" size={20} />
        </button>
        <button id="locate-me" class="map-btn" title={t.stopDetailMyLocation}>
          <Icon name="location" size={20} />
        </button>
      </div>
    </div>

    <div id="eta-container">
      <h3>{t.stopDetailNextBuses}</h3>
      <div id="eta-list" class="grid-list anim-stagger">
        <div class="loading-state">
          <div class="loading">{t.stopDetailCheckingTimes}</div>
          <div class="skeleton-stack" aria-hidden="true">
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Refresh cooldown banner (shown when the server fails) -->
    <div id="cooldown-banner" class="cooldown-banner" style="display: none;">
      <div class="cooldown-title">...</div>
      <div class="cooldown-desc">...</div>
    </div>

    <!-- Destination Selector Modal -->
    <div id="destination-modal" class="modal-overlay" style="display: none;">
      <div class="modal-content card">
        <h3>{t.stopDetailWhereTo}</h3>
        <p class="text-muted small">{t.stopDetailSelectDest}</p>
        <button type="button" id="btn-alert-only" class="alert-only-option">
          <span class="alert-only-icon"><i data-lucide="bell" style="width: 18px; height: 18px;"></i></span>
          <span class="alert-only-text">
            <strong>{t.stopDetailAlertOnly}</strong>
            <small>{t.stopDetailAlertOnlyDesc}</small>
          </span>
        </button>
        <div id="stops-list-modal" class="modal-list"></div>
        <button id="close-modal" class="btn-secondary mt-1">{t.stopDetailCancel}</button>
      </div>
    </div>

    <div id="stop-lines" class="mt-2">
      <h3>{t.stopDetailPassingLines}</h3>
      <div id="lines-passing" class="flex-wrap gap-1"></div>
    </div>

    <!-- Walking Departure Time Configuration Card (Collapsed by default, moved below lines) -->
    <div id="walk-times-card" class="card walk-times-card mt-2">
      <div class="walk-card-header" id="toggle-walk-card">
        <div class="walk-card-title-wrap">
          <div>
            <h4>{t.walkTimesTitle}</h4>
            <p class="text-muted small">{t.walkTimesDesc}</p>
          </div>
        </div>
        <div class="walk-card-chevron-wrap">
          <i data-lucide="chevron-down" class="walk-card-chevron" id="walk-card-caret"></i>
        </div>
      </div>
      <div class="walk-card-body" id="walk-card-body" style="display: none;">
        <div class="walk-loc-section">
          <div class="walk-loc-header">
            <span class="walk-loc-label">{t.walkTimeActiveLabel}</span>
            <button type="button" class="btn-walk-settings" id="btn-walk-settings" title={t.settingsLocationsTitle} aria-label={t.settingsLocationsTitle}>
              <Icon name="settings" size={18} />
            </button>
          </div>
          <div class="walk-loc-pills" id="walk-loc-pills"></div>
          <div class="walk-loc-status" id="walk-loc-status" style="display: none;"></div>
        </div>

        <div class="walk-time-control-panel" id="walk-time-control-panel" style="display: none;">
          <div class="walk-time-stepper-wrap">
            <div class="walk-time-stepper">
              <button type="button" class="btn-stepper" id="btn-walk-minus" aria-label="Restar 1 minuto">
                <i data-lucide="minus"></i>
              </button>
              <div class="walk-time-display">
                <span id="walk-time-val">--</span>
                <small>{t.walkTimeMinutesLabel}</small>
              </div>
              <button type="button" class="btn-stepper" id="btn-walk-plus" aria-label="Sumar 1 minuto">
                <i data-lucide="plus"></i>
              </button>
            </div>
            
            <button type="button" class="btn-clear-walk" id="btn-clear-walk" style="display: none;">
              <i data-lucide="trash-2"></i>
              <span>{lang === 'en' ? 'Clear' : 'Borrar'}</span>
            </button>
          </div>

          <div class="walk-presets-row">
            <button type="button" class="btn-preset" data-preset="3">3 min</button>
            <button type="button" class="btn-preset" data-preset="5">5 min</button>
            <button type="button" class="btn-preset" data-preset="8">8 min</button>
            <button type="button" class="btn-preset" data-preset="10">10 min</button>
            <button type="button" class="btn-preset" data-preset="15">15 min</button>
          </div>
        </div>
        
        <div id="walk-time-hint" class="walk-time-hint"></div>
      </div>
    </div>
  </section>

  <script>
    import { storage } from '../../utils/storage';
    import { inAppAlert } from '../../utils/inAppAlert';
    import { getPosition, isNativePlatform } from '../../utils/geolocation';
    import { Geolocation } from '@capacitor/geolocation';
    import { API, isApiCooldownActive } from '../../services/api';
    import { tracking } from '../../utils/tracking';
    import { createIcons, Star, Navigation, Map, LocateFixed, Bell, Home, Briefcase, MapPin, Plus, Minus, Clock, Trash2, ChevronDown, Check, Settings, Crosshair, CircleSlash } from 'lucide';
    import { getTranslations } from '../../utils/i18n';
    import { requestBgAlertPermission } from '../../utils/backgroundAlerts';

    const lang = document.documentElement.getAttribute('data-lang') || 'es';
    const t = getTranslations(lang);

    // Get ID from URL or query parameters
    const urlParams = new URLSearchParams(window.location.search);
    const queryId = urlParams.get('id') || urlParams.get('stopId');
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const lastSeg = pathSegments[pathSegments.length - 1] || '';
    const parsedPathId = parseInt(lastSeg.replace(/\.html?$/, ''), 10);
    const stopId = !isNaN(parsedPathId) ? parsedPathId : (queryId ? parseInt(queryId, 10) : NaN);

    let map: any = null;
    let stopData: any = null;
    let pendingTracking: { busId: string, lineId: number } | null = null;
    let satelliteLayer: any = null;
    let isSatellite = false;
    let userMarker: any = null;
    let watchId: any = null;
    let guidanceLine: any = null;
    let etaInterval: any = null;

    // "Coge el bus" suggestion coming from a planner favorite (line/dest +
    // optional arrive-at time). favourites.astro passes it via query params.
    // Sugerencia de bus a coger procedente de un favorito del planificador.
    let suggestion: {
      lineId: number | null;
      destId: number | null;
      mode: string;
      targetTime: string | null;
    } | null = null;
    // Live ETA at the favourite destination stop per bus id (func=0), cached.
    let destEtaCache: { destId: number; asOf: number; etaByBus: Record<string, number> } | null = null;

    function findStop(cat: any, id: number | string) {
      if (!cat || !cat.paradas) return null;
      if (Array.isArray(cat.paradas)) {
        return cat.paradas.find((s: any) => String(s.id) === String(id)) || null;
      }
      return cat.paradas[id] || cat.paradas[String(id)] || null;
    }

    // Refresh cooldown (protects the upstream API from being hammered)
    const COOLDOWN_MS = 30000;
    const COOLDOWN_KEY = 'buscoruna_eta_cooldown_until';
    let cooldownUntil = parseInt(sessionStorage.getItem(COOLDOWN_KEY) || '0', 10) || 0;
    let cooldownTimer: any = null;
    const cooldownBanner = document.getElementById('cooldown-banner');

    function isCooldownActive() {
      return Date.now() < cooldownUntil;
    }

    function restartEtaRefresh() {
      if (etaInterval) clearInterval(etaInterval);
      etaInterval = setInterval(fetchETAs, 30000);
    }

    function stopEtaRefresh() {
      if (etaInterval) {
        clearInterval(etaInterval);
        etaInterval = null;
      }
    }

    function startCooldown() {
      if (isCooldownActive()) return; // don't extend an already active cooldown
      stopEtaRefresh();
      cooldownUntil = Date.now() + COOLDOWN_MS;
      sessionStorage.setItem(COOLDOWN_KEY, cooldownUntil.toString());
      renderCooldownBanner();
    }

    function finishCooldown() {
      if (cooldownTimer) {
        clearInterval(cooldownTimer);
        cooldownTimer = null;
      }
      if (cooldownBanner) cooldownBanner.style.display = 'none';
      sessionStorage.removeItem(COOLDOWN_KEY);
      cooldownUntil = 0;
      restartEtaRefresh();
      fetchETAs();
      fetchETAs();
    }

    function renderCooldownBanner() {
      if (!cooldownBanner) return;
      const titleEl = cooldownBanner.querySelector('.cooldown-title');
      const descEl = cooldownBanner.querySelector('.cooldown-desc');

      const tick = () => {
        const remaining = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
        if (remaining <= 0) {
          finishCooldown();
          return;
        }
        if (titleEl) titleEl.textContent = t.cooldownBannerTitle;
        if (descEl) descEl.innerHTML = t.cooldownBannerDesc.replace('{n}', String(remaining));
      };

      cooldownBanner.style.display = 'block';
      tick();
      if (cooldownTimer) clearInterval(cooldownTimer);
      cooldownTimer = setInterval(tick, 1000);
    }

    function setupMapExpand() {
      const expandBtn = document.getElementById('expand-stop-map');
      const collapseBtn = document.getElementById('collapse-stop-map');
      const container = document.getElementById('stop-map-container');

      const setFullscreen = (on: boolean) => {
        container?.classList.toggle('map-fullscreen', on);
        if (expandBtn) expandBtn.style.display = on ? 'none' : 'flex';
        if (collapseBtn) collapseBtn.style.display = on ? 'flex' : 'none';
        setTimeout(() => map?.invalidateSize(), on ? 100 : 250);
      };

      expandBtn?.addEventListener('click', () => setFullscreen(true));
      collapseBtn?.addEventListener('click', () => setFullscreen(false));

      // Google Street View of the stop
      const streetViewBtn = document.getElementById('street-view-btn');
      streetViewBtn?.addEventListener('click', () => {
        if (!stopData) return;
        window.open(
          `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${stopData.posy},${stopData.posx}`,
          '_blank',
          'noopener'
        );
      });
    }

    // Render Lucide icons on dynamic elements
    function renderIcons() {
      createIcons({
        icons: {
          Star,
          Navigation,
          Map,
          LocateFixed,
          Bell,
          Home,
          Briefcase,
          MapPin,
          Plus,
          Minus,
          Clock,
          Trash2,
          ChevronDown,
          Check,
          Settings,
          Crosshair,
          CircleSlash
        }
      });
    }

    async function init() {
      if (isNaN(stopId)) {
        window.location.href = '/stops';
        return;
      }

      document.getElementById('display-stop-id')!.textContent = stopId.toString();
      
      const customNames = storage.getStopNames();
      const alias = customNames[String(stopId)];

      setupMapExpand();
      updateFavoriteUI();
      initWalkTimesUI();

      const catalog = storage.getCatalog();
      stopData = findStop(catalog, stopId);

      if (stopData) {
        renderStopInfo();
        initMap();
      } else {
        document.getElementById('display-stop-name')!.textContent = alias || `${lang === 'en' ? 'Stop' : 'Parada'} ${stopId}`;
        
        // Actively load catalog in background if missing
        API.getCatalog().then((res: any) => {
          if (res && (res.resultado === 'OK' || res.iTranvias)) {
            const raw = res.iTranvias || res;
            const paradasRecord: any = {};
            const paradasList = (raw.paradas) || (raw.actualizacion && raw.actualizacion.paradas) || [];
            paradasList.forEach((s: any) => {
              if (s && s.id !== undefined) {
                paradasRecord[s.id] = s;
                paradasRecord[String(s.id)] = s;
              }
            });
            const newCat = { actualizacion: raw.actualizacion || raw, paradas: paradasRecord };
            storage.setCatalog(newCat);
            stopData = findStop(newCat, stopId);
            if (stopData) {
              renderStopInfo();
              initMap();
            }
          }
        }).catch(() => {});

        window.addEventListener('catalog-loaded', () => {
          const cat = storage.getCatalog();
          stopData = findStop(cat, stopId);
          if (stopData) {
            renderStopInfo();
            initMap();
          }
        }, { once: true });
      }

      // Favorite suggestion from the planner: highlight the concrete bus to
      // board today so the favourite's plan is fulfilled.
      // Sugerencia de favorito del planificador: resaltar hoy el bus a coger.
      const hintLine = urlParams.get('line');
      const hintDest = urlParams.get('dest');
      if (hintLine && hintDest) {
        suggestion = {
          lineId: parseInt(hintLine),
          destId: parseInt(hintDest),
          mode: urlParams.get('mode') || 'now',
          targetTime: urlParams.get('time'),
        };
      }

      fetchETAs();
      restartEtaRefresh();

      window.addEventListener('request-refresh', () => {
        fetchETAs();
      });

      window.addEventListener('tracking-updated', () => applyTrackingHighlight());

      document.getElementById('close-modal')?.addEventListener('click', () => {
        document.getElementById('destination-modal')!.style.display = 'none';
      });
    }

    function renderStopInfo() {
      const loadEl = document.getElementById('header-loading');
      const realEl = document.getElementById('header-real');
      if (loadEl) loadEl.style.display = 'none';
      if (realEl) realEl.style.display = '';
      const catalog = storage.getCatalog();
      const customNames = storage.getStopNames();
      const alias = customNames[String(stopId)];
      document.getElementById('display-stop-id')!.textContent = stopId.toString();
      document.getElementById('display-stop-name')!.textContent = alias || stopData?.nombre || `${lang === 'en' ? 'Stop' : 'Parada'} ${stopId}`;
      
      const linesContainer = document.getElementById('lines-passing')!;
      if (stopData && Array.isArray(stopData.enlaces)) {
        linesContainer.innerHTML = stopData.enlaces.map((lId: any) => {
          const line = catalog?.actualizacion?.lineas?.find((cl: any) => cl.id.toString() === lId.toString());
          const name = line ? line.lin_comer : lId;
          const color = line ? `#${line.color}` : '#333';
          return `
            <a href="/lines?id=${lId}" class="line-tag-large" style="--line-color: ${color}">
              ${name}
            </a>
          `;
        }).join('');
      }
    }

    function initMap() {
      const loadEl = document.getElementById('stop-map-loading');
      if (loadEl) loadEl.style.display = 'none';
      if (!map && stopData) {
        // @ts-ignore
        map = L.map('stop-map', { zoomControl: false }).setView([stopData.posy, stopData.posx], 17);
        // @ts-ignore
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OSM'
        }).addTo(map);
        // @ts-ignore
        L.marker([stopData.posy, stopData.posx]).addTo(map);
        
        setupMapActions();
      }
    }

    function setupMapActions() {
      const satBtn = document.getElementById('toggle-satellite');
      const locateBtn = document.getElementById('locate-me');

      satBtn?.addEventListener('click', () => {
        isSatellite = !isSatellite;
        if (isSatellite) {
          if (!satelliteLayer) {
            // @ts-ignore
            satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
              attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EBP, and the GIS User Community'
            });
          }
          satelliteLayer.addTo(map);
          satBtn.classList.add('active');
        } else {
          if (satelliteLayer) satelliteLayer.remove();
          satBtn.classList.remove('active');
        }
      });

      locateBtn?.addEventListener('click', () => {
        if (watchId) {
          Geolocation.clearWatch({ id: watchId as string }).catch(() => {});
          watchId = null;
          if (userMarker) userMarker.remove();
          if (guidanceLine) guidanceLine.remove();
          locateBtn.classList.remove('active');
          return;
        }

        locateBtn.classList.add('active');
        Geolocation.watchPosition({ enableHighAccuracy: true, timeout: 10000 }, (pos: any) => {
          if (!pos || !pos.coords) return;
          const { latitude, longitude, heading } = pos.coords;
          const latlng = [latitude, longitude];

          if (!userMarker) {
            // @ts-ignore
            const userIcon = L.divIcon({
              className: 'user-location-marker',
              html: `<div class="marker-container"><div class="marker-dot"></div><div class="marker-arrow" style="transform: rotate(${heading || 0}deg)"></div></div>`,
              iconSize: [30, 30],
              iconAnchor: [15, 15]
            });
            // @ts-ignore
            userMarker = L.marker(latlng, { icon: userIcon }).addTo(map);
          } else {
            userMarker.setLatLng(latlng);
            const arrow = document.querySelector('.marker-arrow') as HTMLElement;
            if (arrow && heading !== null) arrow.style.transform = `rotate(${heading}deg)`;
          }

          updateGuidanceLine(latitude, longitude);
          // @ts-ignore
          map.panTo(latlng);
        }, (err: any) => {
          console.error(err);
          locateBtn.classList.remove('active');
        }).then((id: any) => { watchId = id; }).catch(() => {});
      });
    }

    function updateGuidanceLine(uLat: number, uLon: number) {
      if (!stopData || !map) return;
      if (guidanceLine) guidanceLine.remove();
      // @ts-ignore
      guidanceLine = L.polyline([[uLat, uLon], [stopData.posy, stopData.posx]], {
        color: 'var(--primary)',
        dashArray: '5, 10',
        weight: 3,
        opacity: 0.6
      }).addTo(map);
    }

    async function fetchETAs() {
      const container = document.getElementById('eta-list')!;
      if (isApiCooldownActive()) return; // global breaker open - fail fast, keep banner

      try {
        const data = await API.getStopArrivals(stopId);
        const catalog = storage.getCatalog();
        if (data.resultado === 'OK' && data.buses && data.buses.lineas && data.buses.lineas.length > 0) {
          container.innerHTML = data.buses.lineas.map((l: any, idx: number) => {
            const lineData = catalog?.actualizacion?.lineas?.find((cl: any) => cl.id.toString() === l.linea.toString());
            const color = lineData ? `#${lineData.color}` : 'var(--primary)';
            const commercialName = lineData ? lineData.lin_comer : l.linea;
            
            return `
              <div class="card eta-card clickable-row" style="--line-color: ${color}" data-idx="${idx}">
                <div class="eta-main-info">
                  <div class="eta-line-info">
                    <span class="line-num-badge" style="background-color: ${color}">${commercialName}</span>
                    <div class="eta-dest">
                      <strong>${l.buses[0]?.destino || ''}</strong>
                      <div class="eta-bus-info">
                        ${l.buses[0]?.bus ? `<span class="bus-id">Bus: ${l.buses[0].bus}</span>` : ''}
                        ${l.buses.length > 1 ? `<span class="next-label">${lang === 'en' ? `See +${l.buses.length - 1} buses` : `Ver +${l.buses.length - 1} buses`}</span>` : ''}
                      </div>
                    </div>
                  </div>
                  <div class="eta-right-actions">
                    <div class="eta-time-container" style="color: ${color}; background-color: ${color}15">
                      <span class="time-val">${l.buses[0]?.tiempo ?? '?'}</span>
                      <span class="time-unit">min</span>
                    </div>
                    ${l.buses[0]?.bus ? `
                      <button class="btn-track-subtle" data-bus="${l.buses[0].bus}" data-line="${l.linea}" title="${t.stopDetailTrackTitle}">
                        <i data-lucide="navigation" style="width: 18px; height: 18px;"></i>
                      </button>
                    ` : ''}
                  </div>
                </div>

                ${l.buses.length > 1 ? `
                  <div class="eta-extra-buses" id="extra-${idx}" style="display: none;">
                    ${l.buses.slice(1).map((b: any, bIdx: number) => `
                      <div class="extra-bus-row">
                        <div class="extra-bus-main">
                          <span>${lang === 'en' ? 'Next bus' : 'Próximo bus'}: <strong>${b.destino || ''}</strong></span>
                          ${b.bus ? `<small class="extra-bus-id">Bus: ${b.bus}</small>` : ''}
                        </div>
                        <div class="extra-bus-right">
                          <span class="extra-time"><strong>${b.tiempo}</strong> min</span>
                          ${b.bus ? `
                            <button class="btn-track-subtle-small" data-bus="${b.bus}" data-line="${l.linea}" title="${t.stopDetailTrackTitle}">
                              <i data-lucide="navigation" style="width: 14px; height: 14px;"></i>
                            </button>
                          ` : ''}
                        </div>
                      </div>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

          renderIcons();

          // Add click listeners to rows for expansion
          container.querySelectorAll('.clickable-row').forEach(row => {
            row.addEventListener('click', (e) => {
              // Ignore if clicking the track button
              if ((e.target as HTMLElement).closest('button')) return;

              const idx = row.getAttribute('data-idx');
              const extra = document.getElementById(`extra-${idx}`);
              if (extra) {
                const isHidden = extra.style.display === 'none';
                extra.style.display = isHidden ? 'block' : 'none';
                row.classList.toggle('is-expanded', isHidden);
              }
            });
          });

          // Add a single unified tracking button (arrival alert + route tracking)
          // Un único botón de seguimiento (aviso de llegada + seguimiento de ruta)
          container.querySelectorAll('.btn-track-subtle, .btn-track-subtle-small').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const busId = btn.getAttribute('data-bus')!;
              const lineId = parseInt(btn.getAttribute('data-line')!);
              
              const currentTargetId = tracking.getTargetDestination();
              
              let isValidTarget = false;
              let plannedRoute: any = null;
              if (currentTargetId) {
                 const line = catalog.actualizacion.lineas.find(l => l.id === lineId);
                 if (line) {
                    const route = line.rutas.find(r => r.paradas.includes(stopId) && r.paradas.includes(currentTargetId));
                    if (route) {
                       const cIdx = route.paradas.indexOf(stopId);
                       const tIdx = route.paradas.indexOf(currentTargetId);
                       if (tIdx > cIdx) {
                         isValidTarget = true;
                         plannedRoute = route;
                       }
                    }
                 }
              }

              if (isValidTarget && currentTargetId) {
                pendingTracking = { busId, lineId };
                startTracking(currentTargetId, { planned: true });
                tracking.clearTargetDestination();
              } else {
                openDestinationSelector(busId, lineId);
              }
            });
          });

          // Mark the bus/line currently being tracked (highlight survives re-renders).
          // Marcar el bus/línea en seguimiento (el resaltado sobrevive a re-renderizados).
          applyTrackingHighlight(container);

          // Highlight today's bus to board to fulfil a planner favourite.
          // Resaltar hoy el bus a coger para cumplir un favorito del planificador.
          await applyRecommendedBus(container, data.buses.lineas);

        } else {
          container.innerHTML = `<div class="empty-state-small">${lang === 'en' ? 'No upcoming buses at this moment.' : 'No hay buses próximos en este momento.'}</div>`;
        }
      } catch (err) {
        console.error('ETA fetch error:', err);
        container.innerHTML = `<div class="error">${lang === 'en' ? 'Error connecting to the server.' : 'Error al conectar con el servidor.'}</div>`;
        startCooldown();
      }
    }

    // Mark the button (and card) of the bus/line currently being tracked for
    // this stop. Re-applied after every render and on tracking changes.
    // Marcar el botón (y la tarjeta) del bus/línea en seguimiento para esta
    // parada. Se re-aplica tras cada renderizado y al cambiar el seguimiento.
    function applyTrackingHighlight(root?: HTMLElement) {
      const el = root || document.getElementById('eta-list');
      if (!el) return;
      const info = tracking.get();
      const tracked = info && String(info.originStopId) === String(stopId);
      el.querySelectorAll('.eta-card').forEach((card: any) => {
        const btn = card.querySelector('.btn-track-subtle, .btn-track-subtle-small');
        const active = !!tracked && !!btn &&
          btn.getAttribute('data-bus') === info.busId &&
          String(btn.getAttribute('data-line')) === String(info.lineId);
        card.classList.toggle('is-tracked', active);
        btn?.classList.toggle('tracking-active', active);
        if (btn && active) {
          const color = (card as HTMLElement).style.getPropertyValue('--line-color') || '#3b82f6';
          btn.style.background = color;
          btn.style.borderColor = color;
          btn.style.color = '#fff';
        } else if (btn) {
          btn.style.background = '';
          btn.style.borderColor = '';
          btn.style.color = '';
        }
      });
    }

    // Highlight the concrete bus to board to fulfil a planner favourite
    // (line + destination + optional "arrive at" target time), recomputed on
    // every refresh from today's live predictions: live ETA at the destination
    // stop when known (func=0), else a per-stop estimate. Mirrors the
    // planner's "recommended bus" logic (latest bus that still arrives on
    // time; otherwise the next bus).
    // Resalta el bus concreto a coger para cumplir un favorito guardado desde
    // el planificador: ETA en vivo en la parada destino si se conoce, si no
    // estimación por parada. Mismo criterio que el planificador.
    async function applyRecommendedBus(container: HTMLElement, lineas: any[]) {
      if (!suggestion || !suggestion.lineId || !suggestion.destId) return;
      try {
        const sugLineId = suggestion.lineId;
        const lineArr = lineas.find((l: any) => l.linea.toString() === sugLineId.toString());
        if (!lineArr || !Array.isArray(lineArr.buses) || lineArr.buses.length === 0) return;

        // Live ETA at the favourite destination stop per bus id, cached 60s.
        let etaByBus: Record<string, number> = {};
        if (!destEtaCache || destEtaCache.destId !== suggestion.destId || Date.now() - destEtaCache.asOf > 60000) {
          if (!isApiCooldownActive()) {
            try {
              const dData = await API.getStopArrivals(suggestion.destId);
              etaByBus = {};
              if (dData.resultado === 'OK' && dData.buses && Array.isArray(dData.buses.lineas)) {
                for (const dl of dData.buses.lineas) {
                  if (dl.linea.toString() !== sugLineId.toString()) continue;
                  for (const db of (dl.buses || [])) {
                    if (!db.bus) continue;
                    let tt = typeof db.tiempo === 'number' ? db.tiempo : parseInt(db.tiempo);
                    if (isNaN(tt)) tt = -1;
                    etaByBus[db.bus.toString()] = tt;
                  }
                }
              }
              destEtaCache = { destId: suggestion.destId, asOf: Date.now(), etaByBus };
            } catch {
              destEtaCache = { destId: suggestion.destId, asOf: Date.now(), etaByBus };
            }
          }
        } else {
          etaByBus = destEtaCache.etaByBus;
        }

        // Stops between the current stop and the favourite destination.
        let stopsBetween: number | null = null;
        const cat = storage.getCatalog();
        const lineMeta = cat?.actualizacion?.lineas?.find((l: any) => l.id.toString() === sugLineId.toString());
        if (lineMeta && Array.isArray(lineMeta.rutas)) {
          const route = lineMeta.rutas.find((r: any) => {
            const ids = (r.paradas || []).map((p: any) => Number(p));
            return ids.includes(Number(stopId)) && ids.includes(Number(suggestion!.destId));
          });
          if (route) {
            const ids = route.paradas.map((p: any) => Number(p));
            const ai = ids.indexOf(Number(stopId));
            const bi = ids.indexOf(Number(suggestion!.destId));
            if (ai !== -1 && bi !== -1 && bi > ai) stopsBetween = bi - ai;
          }
        }

        const now = Date.now();
        const available = lineArr.buses
          .map((b: any) => {
            const t = typeof b.tiempo === 'number' ? b.tiempo : parseInt(b.tiempo);
            const originMins = isNaN(t) ? 0 : t;
            let destMins = (b.bus ? etaByBus[b.bus.toString()] : undefined) ?? -1;
            if (destMins < 0) {
              destMins = originMins + (stopsBetween != null ? stopsBetween * 2.5 : 10);
            }
            return { busId: b.bus ? b.bus.toString() : null, arriveAt: new Date(now + destMins * 60000) };
          })
          .filter((x: any) => x.busId);
        if (available.length === 0) return;

        let rec: any;
        if (suggestion.mode === 'arrive' && suggestion.targetTime) {
          const [hh, mm] = suggestion.targetTime.split(':').map(Number);
          const target = new Date();
          target.setHours(hh, mm, 0, 0);
          if (target.getTime() < now) target.setDate(target.getDate() + 1);
          const safe = available.filter((x: any) => x.arriveAt.getTime() <= target.getTime());
          rec = safe.length > 0
            ? [...safe].sort((a: any, b: any) => b.arriveAt.getTime() - a.arriveAt.getTime())[0]
            : available[0];
        } else {
          rec = available[0];
        }
        if (!rec || !rec.busId) return;

        container.querySelectorAll('.eta-card').forEach((card: any) => {
          const btn = card.querySelector('.btn-track-subtle, .btn-track-subtle-small');
          if (!btn || btn.getAttribute('data-line') !== sugLineId.toString()) return;

          const tracked = card.classList.contains('is-tracked');

          // Chip with the bus to board and its estimated arrival at destination.
          let chip = card.querySelector('.rec-chip') as HTMLElement | null;
          if (!chip) {
            chip = document.createElement('div');
            chip.className = 'rec-chip';
            const extra = card.querySelector('.eta-extra-buses');
            if (extra) extra.parentNode?.insertBefore(chip, extra);
            else card.appendChild(chip);
          }
          const etaClock = rec.arriveAt.toLocaleTimeString(
            lang === 'en' ? 'en-US' : 'es-ES',
            { hour: '2-digit', minute: '2-digit' },
          );
          chip.textContent = lang === 'en'
            ? `✓ Board bus ${rec.busId} · Arrives ~${etaClock}`
            : `✓ Coge el bus ${rec.busId} · Llega ~${etaClock}`;

          // Ring only when this bus is not already tracked (the blue tracking
          // highlight wins in that case). The follow button is never painted.
          if (!tracked) card.classList.add('has-recommended');

          // Expand the extra list so the recommended bus is visible and tint
          // its row (the follow button stays untouched until pressed).
          const extra = card.querySelector('.eta-extra-buses') as HTMLElement | null;
          if (extra) {
            extra.style.display = 'block';
            card.classList.add('is-expanded');
            extra.querySelectorAll('.extra-bus-row').forEach((row: any) => {
              const rowBtn = row.querySelector('.btn-track-subtle-small');
              row.classList.toggle(
                'is-rec-bus',
                !!rowBtn && rowBtn.getAttribute('data-bus') === rec.busId,
              );
            });
          }
        });
      } catch (err) {
        console.warn('applyRecommendedBus error:', err);
      }
    }

    function openDestinationSelector(busId: string, lineId: number) {
      pendingTracking = { busId, lineId };
      const catalog = storage.getCatalog();
      if (!catalog) return;

      const line = catalog.actualizacion.lineas.find(l => l.id === lineId);
      if (!line) return;

      // Find which route contains the current stop
      const route = line.rutas.find(r => r.paradas.includes(stopId));
      if (!route) return;

      // Filter stops that are AFTER the current stop in the route
      const currentIdx = route.paradas.indexOf(stopId);
      const upcomingStopIds = route.paradas.slice(currentIdx + 1);

      const modalList = document.getElementById('stops-list-modal')!;
      const plannedId = tracking.getTargetDestination();
      if (upcomingStopIds.length === 0) {
        modalList.innerHTML = `<p class="text-muted">${lang === 'en' ? 'No subsequent stops on this route.' : 'No hay paradas posteriores en esta ruta.'}</p>`;
      } else {
        modalList.innerHTML = upcomingStopIds.map(sId => {
          const s = catalog.paradas[sId];
          const isPlanned = plannedId !== null && sId === plannedId;
          return `
            <div class="modal-list-item ${isPlanned ? 'planned' : ''}" data-stop="${sId}">
              <strong>${s?.nombre || sId}${isPlanned ? ` <span class="planned-badge">✓ ${t.stopDetailPlannedBadge}</span>` : ''}</strong>
              <small>${lang === 'en' ? 'Stop' : 'Parada'} ${sId}</small>
            </div>
          `;
        }).join('');

        modalList.querySelectorAll('.modal-list-item').forEach(item => {
          item.addEventListener('click', () => {
            const destStopId = parseInt(item.getAttribute('data-stop')!);
            startTracking(destStopId);
          });
        });
      }

      // "Only alert me when it arrives": no destination needed.
      // Opción "solo avísame de la llegada": no necesita destino.
      const alertOnlyBtn = document.getElementById('btn-alert-only');
      if (alertOnlyBtn) {
        alertOnlyBtn.onclick = () => {
          startTracking(stopId, { alertOnly: true });
        };
      }

      document.getElementById('destination-modal')!.style.display = 'flex';
    }

    function startTracking(destStopId: number, opts?: { planned?: boolean; alertOnly?: boolean }) {
      if (!pendingTracking) return;

      const alertOnly = !!opts?.alertOnly;

      localStorage.setItem('buscoruna_gps_alert_enabled', 'true');
      localStorage.setItem('buscoruna_eta_alert_enabled', 'true');
      requestBgAlertPermission().catch(() => {});

      // Snapshot the walking head-start from the active saved location (which
      // may have been auto-detected by geolocation) so the unified flow can
      // alert the user with enough time to leave.
      const activeLocId = storage.getActiveLocationId();
      const activeLoc = storage.getActiveLocation();
      const walkMins = activeLocId && activeLoc
        ? (storage.getStopWalkingTime(stopId, activeLocId) || 0)
        : 0;

      const catalog = storage.getCatalog();
      const destStop = catalog?.paradas ? catalog.paradas[destStopId] : null;

      tracking.set({
        busId: pendingTracking.busId,
        lineId: pendingTracking.lineId,
        destinationStopId: destStopId,
        originStopId: stopId,
        lastEta: null,
        arrivalTime: null,
        phase: 'toStop',
        walkMinutes: walkMins,
        locationName: walkMins > 0 ? (activeLoc?.name || '') : '',
        destinationName: destStop?.nombre || `${lang === 'en' ? 'Stop' : 'Parada'} ${destStopId}`
      });

      document.getElementById('destination-modal')!.style.display = 'none';

      const planned = opts?.planned && destStop;
      const msg = alertOnly
        ? (lang === 'en'
          ? `Arrival alert set for bus ${pendingTracking.busId}. We will notify you when it reaches this stop.`
          : `¡Aviso de llegada activado para el bus ${pendingTracking.busId}! Te avisaremos cuando llegue a esta parada.`)
        : planned
          ? t.trackingNearPlannedStop.replace('{stop}', destStop.nombre)
          : (lang === 'en'
            ? 'Tracking started! First we alert you when the bus arrives at this stop, then we count the remaining time to your destination.'
            : '¡Seguimiento iniciado! Primero te avisamos cuando llegue el bus a esta parada y luego contamos el tiempo restante hasta tu destino.');
      inAppAlert(msg, { durationMs: 9000 });
    }

    function updateFavoriteUI() {
      const favs = storage.getFavorites();
      const isFav = favs.includes(stopId);
      const container = document.getElementById('fav-icon-container')!;
      
      if (isFav) {
        container.innerHTML = '<i data-lucide="star" style="fill: currentColor; color: #facc15;"></i>';
      } else {
        container.innerHTML = '<i data-lucide="star"></i>';
      }
      renderIcons();
    }

    function initWalkTimesUI() {
      const card = document.getElementById('walk-times-card');
      const toggleHeader = document.getElementById('toggle-walk-card');
      const body = document.getElementById('walk-card-body');
      const caret = document.getElementById('walk-card-caret');
      const pillsContainer = document.getElementById('walk-loc-pills');
      const timeVal = document.getElementById('walk-time-val');
      const btnMinus = document.getElementById('btn-walk-minus');
      const btnPlus = document.getElementById('btn-walk-plus');
      const btnClear = document.getElementById('btn-clear-walk');
      const hint = document.getElementById('walk-time-hint');
      const btnSettings = document.getElementById('btn-walk-settings');

      if (!card || !pillsContainer) return;

      let isExpanded = false;
      toggleHeader?.addEventListener('click', () => {
        isExpanded = !isExpanded;
        if (body) body.style.display = isExpanded ? 'block' : 'none';
        if (caret) caret.classList.toggle('open', isExpanded);
      });

      btnSettings?.addEventListener('click', (e) => {
        e.stopPropagation();
        const panel = document.getElementById('walk-time-control-panel');
        if (panel) {
          const isHidden = panel.style.display === 'none';
          panel.style.display = isHidden ? 'flex' : 'none';
          btnSettings.classList.toggle('active', isHidden);
        }
      });

      function updateCard() {
        if (!pillsContainer) return;
        const locations = storage.getUserLocations();
        const activeLocId = storage.getActiveLocationId();
        const activeLoc = storage.getActiveLocation();
        const source = storage.getActiveLocationSource();
        const currentMins = storage.getStopWalkingTime(stopId, activeLocId);

        // "Detect by GPS" pill: auto-detect which saved place I am at now.
        const detectPill = `
          <button type="button" class="walk-loc-pill walk-loc-detect" data-detect="1" title="${t.walkTimeDetectBtn}">
            <i data-lucide="crosshair"></i>
            <span>${t.walkTimeDetectBtn}</span>
          </button>
        `;

        // "None" pill: explicitly deselect the current place.
        const nonePill = `
          <button type="button" class="walk-loc-pill walk-loc-none ${!activeLocId ? 'active' : ''}" data-none="1" title="${t.walkTimeDeselect}">
            <i data-lucide="circle-slash"></i>
            <span>${t.walkTimeNone}</span>
          </button>
        `;

        // Render location pills with Lucide icons (no emojis)
        const locPills = locations.map(loc => {
          const isActive = loc.id === activeLocId;
          const locTime = storage.getStopWalkingTime(stopId, loc.id);
          const timeBadge = locTime ? ` (${locTime} min)` : '';
          const iconName = loc.icon === 'home' || loc.id === 'casa' ? 'home' : (loc.icon === 'briefcase' || loc.id === 'trabajo' ? 'briefcase' : 'map-pin');
          const hasGps = typeof loc.lat === 'number' && typeof loc.lon === 'number';
          // Show how the active place was selected (geo detection vs manual).
          const sourceBadge = isActive && source === 'geo'
            ? `<span class="source-badge geo">📍 ${t.walkTimeGeoDetected}</span>`
            : (isActive && source === 'manual' ? `<span class="source-badge manual">${t.walkTimeManual}</span>` : '');
          return `
            <div class="walk-loc-item">
              <button type="button" class="walk-loc-pill ${isActive ? 'active' : ''}" data-loc-id="${loc.id}" title="${isActive ? t.walkTimeDeselect : ''}">
                <i data-lucide="${iconName}"></i>
                <span>${loc.name}${timeBadge}${sourceBadge}</span>
              </button>
              <button type="button" class="walk-loc-gps ${hasGps ? 'has-gps' : ''}" data-gps-id="${loc.id}" title="${hasGps ? t.locGpsClear : t.locGpsSet}" aria-label="${hasGps ? t.locGpsClear : t.locGpsSet}">
                <i data-lucide="locate-fixed"></i>
              </button>
            </div>
          `;
        }).join('');

        pillsContainer.innerHTML = `${detectPill}${nonePill}${locPills}`;

        // Detect-by-GPS action: geolocation picks the closest saved place.
        pillsContainer.querySelector('.walk-loc-detect')?.addEventListener('click', (e) => {
          e.stopPropagation();
          const detectBtn = e.currentTarget as HTMLElement;
          detectBtn.classList.add('detect-loading');
          getPosition().then((coords) => {
            detectBtn.classList.remove('detect-loading');
            if (coords) {
              const detected = storage.autoSelectLocationFromGPS(coords.lat, coords.lon);
              if (detected) {
                inAppAlert(lang === 'en'
                  ? `📍 Detected: ${detected.name}. Tap another place to change it.`
                  : `📍 Detectado: ${detected.name}. Toca otro lugar para cambiarlo.`, { durationMs: 5000 });
              } else {
                inAppAlert(lang === 'en'
                  ? 'No saved place found near your position. Tap a place below to indicate where you are.'
                  : 'No se ha encontrado ningún lugar guardado cerca de tu posición. Toca un lugar de abajo para indicar dónde estás.', { durationMs: 6000 });
              }
            } else {
              inAppAlert(isNativePlatform() ? t.locGpsFailNative : t.locGpsFailWeb, { durationMs: 6000 });
            }
            updateCard();
          });
        });

        // None pill: remove the current selection.
        pillsContainer.querySelector('.walk-loc-none')?.addEventListener('click', (e) => {
          e.stopPropagation();
          storage.setActiveLocationId('');
          updateCard();
        });

        // Location pills: tapping the active one deselects it; tapping another
        // marks it as the current (manual) place.
        pillsContainer.querySelectorAll('.walk-loc-pill[data-loc-id]').forEach(pill => {
          pill.addEventListener('click', (e) => {
            e.stopPropagation();
            const locId = pill.getAttribute('data-loc-id');
            if (!locId) return;
            if (locId === activeLocId) {
              storage.setActiveLocationId('');
              inAppAlert(t.walkTimeDeselect, { durationMs: 3000 });
            } else {
              storage.setActiveLocationId(locId);
            }
            updateCard();
          });
        });

        pillsContainer.querySelectorAll('.walk-loc-gps').forEach(gpsBtn => {
          gpsBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = gpsBtn.getAttribute('data-gps-id');
            if (!id) return;
            const loc = locations.find(l => l.id === id);
            const hasGps = loc && typeof loc.lat === 'number' && typeof loc.lon === 'number';
            if (hasGps) {
              storage.updateUserLocation(id, { lat: null, lon: null });
              updateCard();
              return;
            }
            gpsBtn.classList.add('gps-loading');
            getPosition().then((coords) => {
              if (coords) {
                storage.updateUserLocation(id, { lat: coords.lat, lon: coords.lon });
                inAppAlert(t.locGpsSuccess, { durationMs: 4000 });
              } else {
                const msg = isNativePlatform() ? t.locGpsFailNative : t.locGpsFailWeb;
                inAppAlert(msg, { durationMs: 6000 });
              }
              gpsBtn.classList.remove('gps-loading');
              updateCard();
            });
          });
        });

        // Status line: which place is active and how it was chosen.
        const statusEl = document.getElementById('walk-loc-status');
        if (statusEl) {
          if (!activeLocId) {
            statusEl.style.display = '';
            statusEl.className = 'walk-loc-status';
            statusEl.innerHTML = `ℹ️ ${t.walkTimeHintNone}`;
          } else if (source === 'geo' && activeLoc) {
            statusEl.style.display = '';
            statusEl.className = 'walk-loc-status geo';
            statusEl.innerHTML = `📍 ${t.walkTimeHintGeo.replace('{name}', activeLoc.name)}`;
          } else if (activeLoc) {
            statusEl.style.display = '';
            statusEl.className = 'walk-loc-status manual';
            statusEl.innerHTML = `✋ ${t.walkTimeHintManual.replace('{name}', activeLoc.name)}`;
          } else {
            statusEl.style.display = 'none';
          }
        }

        // Update stepper value
        if (timeVal) {
          timeVal.textContent = currentMins ? currentMins.toString() : '--';
        }

        if (btnClear) {
          btnClear.style.display = currentMins ? 'inline-flex' : 'none';
        }

        // Update hint text (no emojis, clean markdown)
        if (hint) {
          if (currentMins && currentMins > 0 && activeLoc) {
            hint.innerHTML = lang === 'en'
              ? `<strong>Departure alert configured:</strong> When you tap the tracking button on a bus, we will alert you <strong>${currentMins} min in advance</strong> so you leave <em>${activeLoc.name}</em> on time.`
              : `<strong>Aviso de salida configurado:</strong> Al activar el seguimiento de un bus, te avisaremos <strong>${currentMins} min antes</strong> para que salgas de <em>${activeLoc.name}</em> con tiempo.`;
          } else if (currentMins && currentMins > 0) {
            hint.innerHTML = lang === 'en'
              ? `<strong>Departure alert configured:</strong> We will alert you <strong>${currentMins} min in advance</strong> so you head to the stop on time.`
              : `<strong>Aviso de salida configurado:</strong> Te avisaremos <strong>${currentMins} min antes</strong> para que te dirijas a la parada con tiempo.`;
          } else {
            hint.innerHTML = lang === 'en'
              ? `Indicate how many minutes you take to walk to this stop to receive the departure notification at the right moment.`
              : `Indica cuántos minutos tardas caminando a esta parada para recibir la alerta de salida en el momento exacto.`;
          }
        }

        renderIcons();
      }

      // Presets
      document.querySelectorAll('.walk-presets-row .btn-preset').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const pVal = parseInt(btn.getAttribute('data-preset') || '5', 10);
          const activeLocId = storage.getActiveLocationId();
          storage.setStopWalkingTime(stopId, activeLocId, pVal);
          updateCard();
        });
      });

      btnMinus?.addEventListener('click', (e) => {
        e.stopPropagation();
        const activeLocId = storage.getActiveLocationId();
        const current = storage.getStopWalkingTime(stopId, activeLocId) || 5;
        const next = Math.max(1, current - 1);
        storage.setStopWalkingTime(stopId, activeLocId, next);
        updateCard();
      });

      btnPlus?.addEventListener('click', (e) => {
        e.stopPropagation();
        const activeLocId = storage.getActiveLocationId();
        const current = storage.getStopWalkingTime(stopId, activeLocId) || 4;
        const next = Math.min(60, current + 1);
        storage.setStopWalkingTime(stopId, activeLocId, next);
        updateCard();
      });

      btnClear?.addEventListener('click', (e) => {
        e.stopPropagation();
        const activeLocId = storage.getActiveLocationId();
        storage.setStopWalkingTime(stopId, activeLocId, null);
        updateCard();
      });

      window.addEventListener('active-location-changed', () => updateCard());
      window.addEventListener('user-locations-updated', () => updateCard());
      window.addEventListener('stop-walk-times-updated', (e: any) => {
        if (e.detail?.stopId === String(stopId)) updateCard();
      });

      updateCard();
    }

    document.getElementById('favorite-btn')?.addEventListener('click', () => {
      storage.toggleFavorite(stopId);
      updateFavoriteUI();
    });

    init();
  </script>
</Layout>

<style is:global>
  .stop-detail-page {
    animation: fadeIn 0.3s ease-out;
  }

  .map-container {
    position: relative;
    margin-bottom: 1.5rem;
    /* Own stacking context: keeps the floating map tools (.map-actions, z-index
       1000) BELOW the fixed header (z-index 1000) when the page scrolls. */
    z-index: 1;
  }

  .map-container.map-fullscreen {
    position: fixed;
