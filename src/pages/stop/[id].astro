---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Detalle de Parada - Coruña Bus">
  <section class="stop-detail-page">
    <div id="stop-header" class="card">
      <div class="header-main">
        <div class="stop-id-badge" id="display-stop-id">...</div>
        <h2 id="display-stop-name">Cargando...</h2>
        <button id="favorite-btn" class="fav-btn">
          <div id="fav-icon-container">
            <Icon name="star-outline" />
          </div>
        </button>
      </div>
      <p id="display-stop-address" class="text-muted"></p>
    </div>

    <div id="stop-map" style="height: 200px; margin-bottom: 1.5rem; border-radius: 12px; z-index: 1;"></div>

    <div id="eta-container">
      <h3>Próximos buses</h3>
      <div id="eta-list" class="grid-list">
        <div class="loading">Consultando tiempos...</div>
      </div>
    </div>

    <!-- Destination Selector Modal -->
    <div id="destination-modal" class="modal-overlay" style="display: none;">
      <div class="modal-content card">
        <h3>¿A qué parada vas?</h3>
        <p class="text-muted small">Selecciona tu destino para calcular la llegada.</p>
        <div id="stops-list-modal" class="modal-list"></div>
        <button id="close-modal" class="btn-secondary mt-1">Cancelar</button>
      </div>
    </div>

    <div id="stop-lines" class="mt-2">
      <h3>Líneas en esta parada</h3>
      <div id="lines-passing" class="flex-wrap gap-1"></div>
    </div>
  </section>

  <script>
    import { storage } from '../../utils/storage';
    import { API } from '../../services/api';
    import { tracking } from '../../utils/tracking';
    import { createIcons, Star, Navigation } from 'lucide';

    // Get ID from URL
    const pathParts = window.location.pathname.split('/');
    const stopId = parseInt(pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2]);

    let map: any = null;
    let stopData: any = null;
    let pendingTracking: { busId: string, lineId: number } | null = null;

    function renderIcons() {
      createIcons({
        icons: {
          Star,
          Navigation
        }
      });
    }

    async function init() {
      if (isNaN(stopId)) {
        window.location.href = '/stops';
        return;
      }

      const catalog = storage.getCatalog();
      if (!catalog) {
        // Wait for catalog if not ready
        window.addEventListener('catalog-loaded', () => init());
        return;
      }

      stopData = catalog.paradas[stopId];
      if (!stopData) {
        document.getElementById('display-stop-name')!.textContent = 'Parada no encontrada';
        return;
      }

      renderStopInfo();
      initMap();
      fetchETAs();
      updateFavoriteUI();

      // Refresh ETAs every 30s
      setInterval(fetchETAs, 30000);

      window.addEventListener('request-refresh', fetchETAs);

      document.getElementById('close-modal')?.addEventListener('click', () => {
        document.getElementById('destination-modal')!.style.display = 'none';
      });
    }

    function renderStopInfo() {
      const catalog = storage.getCatalog();
      document.getElementById('display-stop-id')!.textContent = stopId.toString();
      document.getElementById('display-stop-name')!.textContent = stopData.nombre;
      
      const linesContainer = document.getElementById('lines-passing')!;
      linesContainer.innerHTML = stopData.enlaces.map((lId: any) => {
        const line = catalog?.actualizacion.lineas.find((cl: any) => cl.id.toString() === lId.toString());
        const name = line ? line.lin_comer : lId;
        const color = line ? `#${line.color}` : '#333';
        return `
          <a href="/lines?id=${lId}" class="line-tag-large" style="border-left: 4px solid ${color}">
            ${name}
          </a>
        `;
      }).join('');
    }

    function initMap() {
      if (!map && stopData) {
        // @ts-ignore
        map = L.map('stop-map', { zoomControl: false }).setView([stopData.posy, stopData.posx], 17);
        // @ts-ignore
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OSM'
        }).addTo(map);
        // @ts-ignore
        L.marker([stopData.posy, stopData.posx]).addTo(map);
      }
    }

    async function fetchETAs() {
      const container = document.getElementById('eta-list')!;
      const catalog = storage.getCatalog();
      if (!catalog) return;

      try {
        const data = await API.getStopArrivals(stopId);
        if (data.resultado === 'OK' && data.buses && data.buses.lineas && data.buses.lineas.length > 0) {
          container.innerHTML = data.buses.lineas.map((l: any, idx: number) => {
            const lineData = catalog.actualizacion.lineas.find((cl: any) => cl.id.toString() === l.linea.toString());
            const color = lineData ? `#${lineData.color}` : 'var(--primary)';
            const commercialName = lineData ? lineData.lin_comer : l.linea;
            
            return `
              <div class="card eta-card clickable-row" style="border-left: 6px solid ${color}" data-idx="${idx}">
                <div class="eta-main-info">
                  <div class="eta-line-info">
                    <span class="line-num-badge" style="background-color: ${color}">${commercialName}</span>
                    <div class="eta-dest">
                      <strong>${l.buses[0]?.destino || ''}</strong>
                      <div class="eta-bus-info">
                        ${l.buses[0]?.bus ? `<span class="bus-id">Bus: ${l.buses[0].bus}</span>` : ''}
                        ${l.buses.length > 1 ? `<span class="next-label">Ver +${l.buses.length - 1} buses</span>` : ''}
                      </div>
                    </div>
                  </div>
                  <div class="eta-right-actions">
                    <div class="eta-time-container" style="color: ${color}; background-color: ${color}15">
                      <span class="time-val">${l.buses[0]?.tiempo ?? '?'}</span>
                      <span class="time-unit">min</span>
                    </div>
                    ${l.buses[0]?.bus ? `
                      <button class="btn-track-subtle" data-bus="${l.buses[0].bus}" data-line="${l.linea}" title="Subir a este bus">
                        <i data-lucide="navigation" style="width: 18px; height: 18px;"></i>
                      </button>
                    ` : ''}
                  </div>
                </div>

                ${l.buses.length > 1 ? `
                  <div class="eta-extra-buses" id="extra-${idx}" style="display: none;">
                    ${l.buses.slice(1).map((b: any, bIdx: number) => `
                      <div class="extra-bus-row">
                        <div class="extra-bus-main">
                          <span>Próximo bus: <strong>${b.destino || ''}</strong></span>
                          ${b.bus ? `<small class="extra-bus-id">Bus: ${b.bus}</small>` : ''}
                        </div>
                        <div class="extra-bus-right">
                          <span class="extra-time"><strong>${b.tiempo}</strong> min</span>
                          ${b.bus ? `<button class="btn-track-subtle-small" data-bus="${b.bus}" data-line="${l.linea}">
                            <i data-lucide="navigation" style="width: 14px; height: 14px;"></i>
                          </button>` : ''}
                        </div>
                      </div>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

          renderIcons();

          // Add click listeners to rows for expansion
          container.querySelectorAll('.clickable-row').forEach(row => {
            row.addEventListener('click', (e) => {
              // Ignore if clicking the track button
              if ((e.target as HTMLElement).closest('button')) return;

              const idx = row.getAttribute('data-idx');
              const extra = document.getElementById(`extra-${idx}`);
              if (extra) {
                const isHidden = extra.style.display === 'none';
                extra.style.display = isHidden ? 'block' : 'none';
                row.classList.toggle('is-expanded', isHidden);
              }
            });
          });

          // Add track button listeners
          container.querySelectorAll('.btn-track-subtle, .btn-track-subtle-small').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const busId = btn.getAttribute('data-bus')!;
              const lineId = parseInt(btn.getAttribute('data-line')!);
              
              const currentTargetId = tracking.getTargetDestination();
              
              if (currentTargetId) {
                pendingTracking = { busId, lineId };
                startTracking(currentTargetId);
                tracking.clearTargetDestination();
              } else {
                openDestinationSelector(busId, lineId);
              }
            });
          });

        } else {
          container.innerHTML = '<div class="empty-state-small">No hay buses próximos en este momento.</div>';
        }
      } catch (err) {
        container.innerHTML = '<div class="error">Error al conectar con el servidor.</div>';
      }
    }

    function openDestinationSelector(busId: string, lineId: number) {
      pendingTracking = { busId, lineId };
      const catalog = storage.getCatalog();
      if (!catalog) return;

      const line = catalog.actualizacion.lineas.find(l => l.id === lineId);
      if (!line) return;

      // Find which route contains the current stop
      const route = line.rutas.find(r => r.paradas.includes(stopId));
      if (!route) return;

      // Filter stops that are AFTER the current stop in the route
      const currentIdx = route.paradas.indexOf(stopId);
      const upcomingStopIds = route.paradas.slice(currentIdx + 1);

      const modalList = document.getElementById('stops-list-modal')!;
      if (upcomingStopIds.length === 0) {
        modalList.innerHTML = '<p class="text-muted">No hay paradas posteriores en esta ruta.</p>';
      } else {
        modalList.innerHTML = upcomingStopIds.map(sId => {
          const s = catalog.paradas[sId];
          return `
            <div class="modal-list-item" data-stop="${sId}">
              <strong>${s?.nombre || sId}</strong>
              <small>Parada ${sId}</small>
            </div>
          `;
        }).join('');

        modalList.querySelectorAll('.modal-list-item').forEach(item => {
          item.addEventListener('click', () => {
            const destStopId = parseInt(item.getAttribute('data-stop')!);
            startTracking(destStopId);
          });
        });
      }

      document.getElementById('destination-modal')!.style.display = 'flex';
    }

    function startTracking(destStopId: number) {
      if (!pendingTracking) return;

      tracking.set({
        busId: pendingTracking.busId,
        lineId: pendingTracking.lineId,
        destinationStopId: destStopId,
        originStopId: stopId,
        lastEta: null,
        arrivalTime: null
      });

      document.getElementById('destination-modal')!.style.display = 'none';
      alert(`¡Seguimiento iniciado! Te avisaremos cuando llegues a tu destino.`);
    }

    function updateFavoriteUI() {
      const favs = storage.getFavorites();
      const isFav = favs.includes(stopId);
      const container = document.getElementById('fav-icon-container')!;
      
      if (isFav) {
        container.innerHTML = '<i data-lucide="star" style="fill: currentColor; color: #facc15;"></i>';
      } else {
        container.innerHTML = '<i data-lucide="star"></i>';
      }
      renderIcons();
    }

    document.getElementById('favorite-btn')?.addEventListener('click', () => {
      storage.toggleFavorite(stopId);
      updateFavoriteUI();
    });

    init();
  </script>
</Layout>

<style is:global>
  .stop-detail-page {
    animation: fadeIn 0.3s ease-out;
  }

  .header-main {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .stop-id-badge {
    background: #333;
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .fav-btn {
    margin-left: auto;
    background: none;
    font-size: 1.5rem;
    padding: 0.5rem;
  }

  .mt-2 { margin-top: 2rem; }
  
  .line-tag-large {
    background: white;
    border: 1px solid #ddd;
    color: #333;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    margin: 0.25rem;
  }

  .eta-line-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .line-num-badge {
    background: var(--primary);
    color: white;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
  }

  .eta-dest strong {
    font-size: 0.95rem;
    display: block;
  }

  .eta-time-container {
    text-align: right;
    background: #f0fdf4;
    color: #166534;
    padding: 0.5rem;
    border-radius: 8px;
    min-width: 60px;
  }

  .time-val {
    font-size: 1.5rem;
    font-weight: 800;
    display: block;
    line-height: 1;
  }

  .time-unit {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .empty-state-small {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
    background: white;
    border-radius: 12px;
    border: 2px dashed #eee;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .eta-card {
    transition: all 0.2s ease;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .clickable-row {
    cursor: pointer;
  }

  .clickable-row:active {
    background: #fdfdfd;
  }

  .eta-main-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1rem;
  }

  .eta-right-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-track-subtle {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #94a3b8;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .btn-track-subtle:hover, .btn-track-subtle:active {
    color: #3b82f6;
    border-color: #3b82f6;
    background: #f0f7ff;
    transform: scale(1.05);
  }

  .btn-track-subtle-small {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #94a3b8;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  .next-label {
    font-size: 0.75rem;
    color: #3b82f6;
    font-weight: 700;
    margin-top: 2px;
    display: block;
  }

  /* Restoring essential styles */
  .eta-extra-buses {
    width: 100%;
    padding: 0.5rem 1rem 1rem 1rem;
    border-top: 1px solid #eee;
    background: #fafafa;
    border-bottom-right-radius: 12px;
  }

  .extra-bus-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    padding: 0.5rem 0;
    border-bottom: 1px dashed #eee;
  }

  .extra-bus-row:last-child { border-bottom: none; }
  .extra-time { color: #444; }
  .is-expanded { background: #fdfdfd; }
  .eta-bus-info { display: flex; flex-direction: column; gap: 2px; }
  .bus-id { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; }
  .extra-bus-main { display: flex; flex-direction: column; }
  .extra-bus-id { font-size: 0.7rem; color: #888; }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    backdrop-filter: blur(4px);
  }

  .modal-content {
    width: 100%;
    max-width: 400px;
    max-height: 80vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .modal-list {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .modal-list-item {
    padding: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .modal-list-item:active { background: #f0f0f0; transform: scale(0.98); }
  .modal-list-item strong { display: block; font-size: 0.95rem; }
  .modal-list-item small { color: var(--text-muted); }

  .btn-secondary {
    background: #eee;
    color: #333;
    padding: 0.75rem;
    border-radius: 8px;
    font-weight: 600;
    width: 100%;
  }

  .extra-bus-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
