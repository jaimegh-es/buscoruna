    border-color: #3b82f6;
    background: #f0f7ff;
    transform: scale(1.05);
  }

  .btn-track-subtle.tracking-active,
  .btn-track-subtle-small.tracking-active {
    background: #3b82f6;
    border-color: #3b82f6;
    color: #fff;
    transform: scale(1.05);
    animation: tracking-pulse 2s ease-in-out infinite;
  }

  @keyframes tracking-pulse {
    0%, 100% { box-shadow: 0 2px 10px rgba(59, 130, 246, 0.4); }
    50% { box-shadow: 0 2px 18px rgba(59, 130, 246, 0.7); }
  }

  .eta-card.is-tracked { }

  /* Recommended bus (planner favourite). The card ring + chip use the LINE
     color; the follow button is never painted (it only lights up when the
     user actually starts tracking). */
  /* Bus recomendado (favorito del planificador). El anillo y el chip usan el
     color de la LÍNEA; el botón de seguimiento no se pinta hasta usarlo. */
  .rec-chip {
    margin: 0.5rem 0.75rem;
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line-color, var(--primary)) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--line-color, var(--primary)) 45%, transparent);
    color: var(--line-color, var(--primary));
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    width: fit-content;
  }

  .eta-card {
    color: var(--text);
    background: var(--card-bg, #fff);
  }

  .eta-card.has-recommended {
    background: var(--line-color, #3b82f6);
    box-shadow: 0 0 0 2px var(--line-color, #3b82f6), 0 4px 14px rgba(59,130,246,0.35);
  }
  .eta-card.has-recommended .line-num-badge {
    background: rgba(255,255,255,0.9) !important;
    color: var(--line-color, #3b82f6) !important;
  }
  .eta-card.has-recommended .eta-dest,
  .eta-card.has-recommended .time-val,
  .eta-card.has-recommended .time-unit,
  .eta-card.has-recommended .next-label,
  .eta-card.has-recommended .bus-id,
  .eta-card.has-recommended strong { color: #fff; }
  .eta-card.has-recommended .extra-bus-row { background: rgba(255,255,255,0.35) !important; color: var(--text) !important; }
  .eta-card.has-recommended .extra-bus-row span,
  .eta-card.has-recommended .extra-bus-row strong,
  .eta-card.has-recommended .extra-bus-row .extra-bus-id { color: var(--text) !important; }

  .extra-bus-row { color: var(--text); }

  .extra-bus-row.is-rec-bus {
    background: var(--line-color, var(--primary)) !important;
    color: #fff !important;
