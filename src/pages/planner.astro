---
import Layout from "../layouts/Layout.astro";
import TripCalculator from "../components/TripCalculator.astro";
import { getTranslations } from "../utils/i18n";

const lang = Astro.cookies.get('buscoruna_lang')?.value || 'es';
const t = getTranslations(lang);
---

<Layout title={`${t.plannerWhereTo} - Coruña Bus`}>
    <section class="welcome">
        <h2>{t.plannerWhereTo}</h2>
        <p>{t.plannerSubText}</p>
    </section>

    <TripCalculator />

    <section class="quick-links">
        <div class="card">
            <h3>{t.plannerStopsNearCardTitle}</h3>
            <p>{t.plannerStopsNearCardDesc}</p>
            <a href="/stops" class="btn-secondary">{t.plannerStopsNearCardBtn}</a>
        </div>
    </section>
</Layout>

<style>
    .welcome {
        margin-bottom: 2rem;
    }

    .welcome h2 {
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
    }

    .welcome p {
        color: var(--text-muted);
    }

    .quick-links h3 {
        margin-bottom: 0.5rem;
    }

    .btn-secondary {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.5rem 1rem;
        background: #eee;
        color: var(--text);
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
    }
</style>
