---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Favoritos - Coruña Bus">
	<section class="favorites-page">
    <h2>Mis Favoritos</h2>
    <div id="favorites-container">
      <div class="loading">Cargando tus favoritos...</div>
    </div>
  </section>

  <script>
    import { storage } from '../utils/storage';
    import { API } from '../services/api';
    import { tracking } from '../utils/tracking';
    import { createIcons, Star, Heart, ChevronRight, Map } from 'lucide';

    // Load and render all favorites categories (stops, routes, planner trajectories)
    // Cargar y renderizar todas las categorías de favoritos (paradas, rutas, trayectos del planificador)
    async function loadFavorites() {
      const container = document.getElementById('favorites-container');
      if (!container) return;

      const favIds = storage.getFavorites();
      const favRoutes = storage.getFavoriteRoutes();
      const favPlannerRoutes = storage.getFavoritePlannerRoutes();
      const catalog = storage.getCatalog();

      // Check if there are no favorites at all
      // Comprobar si no hay ningún favorito guardado
      if (favIds.length === 0 && favRoutes.length === 0 && favPlannerRoutes.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <span class="icon"><i data-lucide="star"></i></span>
            <p>Aún no tienes favoritos.</p>
            <p><small>Pulsa la estrella en una parada, el corazón en una ruta o guarda un trayecto en el planificador.</small></p>
          </div>
        `;
        createIcons({ icons: { Star } });
        return;
      }

      if (!catalog) {
        container.innerHTML = '<p>Error: Datos del sistema no disponibles.</p>';
        return;
      }

      const lines = catalog.actualizacion.lineas || [];
      const lineMap = lines.reduce((acc: any, line: any) => {
        acc[line.id] = { name: line.lin_comer, color: line.color };
        return acc;
      }, {});

      let html = '';

      // Render favorite stops
      // Renderizar paradas favoritas
      if (favIds.length > 0) {
        html += `
          <h3 class="section-title">Paradas favoritas</h3>
          <div class="stops-list">
            ${favIds.map(id => {
              const s = catalog.paradas[id];
              if (!s) return '';
              return `
                <a href="/stop/${s.id}" class="card stop-card-link">
                  <div class="stop-info">
                    <strong>${s.nombre}</strong>
                    <small>Parada ${s.id}</small>
                    <div class="stop-lines">
                      ${s.enlaces.map((lId: any) => {
                        const info = lineMap[lId];
                        if (!info) return '';
                        return `<span class="line-tag" style="background-color: #${info.color}">${info.name}</span>`;
                      }).join('')}
                    </div>
                  </div>
                  <div class="stop-arrow"><i data-lucide="chevron-right"></i></div>
                </a>
              `;
            }).join('')}
          </div>
        `;
      }

      // Render favorite line routes (specific line connecting origin & dest stops)
      // Renderizar rutas favoritas de líneas (línea específica que conecta origen y destino)
      if (favRoutes.length > 0) {
        html += `
          <h3 class="section-title mt-2">Rutas de líneas favoritas</h3>
          <div class="routes-list">
            ${favRoutes.map(r => {
              const origin = catalog.paradas[r.originId];
              const dest = catalog.paradas[r.destId];
              const line = lines.find((l: any) => l.id === r.lineId);
              const color = line ? `#${line.color}` : 'var(--primary)';
              
              return `
                <a href="/stop/${r.originId}" class="card route-fav-card favorite-route-link" style="--line-color: ${color}" data-dest="${r.destId}">
                  <div class="route-fav-header">
                    <span class="line-badge-small" style="background-color: ${color}">${r.lineName}</span>
                    <div class="route-fav-text">
                      <strong>${origin?.nombre || 'Origen'} &rarr; ${dest?.nombre || 'Destino'}</strong>
                      <small>Desde parada ${r.originId}</small>
                    </div>
                  </div>
                  <div class="stop-arrow"><i data-lucide="chevron-right"></i></div>
                </a>
              `;
            }).join('')}
          </div>
        `;
      }

      // Render favorite planner trajectories (Origin -> Destination search queries)
      // Renderizar trayectos favoritos del planificador (consultas de búsqueda Origen -> Destino)
      if (favPlannerRoutes.length > 0) {
        html += `
          <h3 class="section-title mt-2">Trayectos planificados favoritos</h3>
          <div class="routes-list">
            ${favPlannerRoutes.map(r => {
              const originName = r.origin.nombre;
              const destName = r.destination.nombre;

              // Build URLSearchParams from saved origin/destination stop or custom place
              // Construir URLSearchParams desde el origen/destino guardado (parada o lugar personalizado)
              const params = new URLSearchParams();
              params.set('originType', r.origin.type);
              if (r.origin.type === 'stop') {
                params.set('originId', r.origin.id);
              } else {
                params.set('originName', r.origin.nombre);
                params.set('originLat', r.origin.posy);
                params.set('originLon', r.origin.posx);
              }
              
              params.set('destType', r.destination.type);
              if (r.destination.type === 'stop') {
                params.set('destId', r.destination.id);
              } else {
                params.set('destName', r.destination.nombre);
                params.set('destLat', r.destination.posy);
                params.set('destLon', r.destination.posx);
              }

              if (r.plannerMode) {
                params.set('plannerMode', r.plannerMode);
              }
              if (r.targetTime) {
                params.set('targetTime', r.targetTime);
              }

              const href = `/planner?${params.toString()}`;

              return `
                <a href="${href}" class="card route-fav-card favorite-planner-link" style="--line-color: var(--primary)">
                  <div class="route-fav-header">
                    <span class="line-badge-small flex-center" style="background-color: var(--primary); display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0;">
                      <i data-lucide="map" style="width: 16px; height: 16px; color: white;"></i>
                    </span>
                    <div class="route-fav-text">
                      <strong>${originName} &rarr; ${destName}</strong>
                      <small>
                        ${r.origin.type === 'stop' ? 'Parada ' + r.origin.id : 'Mi ubicación'} &rarr; ${r.destination.type === 'stop' ? 'Parada ' + r.destination.id : 'Ubicación'}
                        ${r.plannerMode === 'arrive' && r.targetTime ? ` • 🕒 Llegar a las ${r.targetTime}` : ''}
                      </small>
                    </div>
                  </div>
                  <div class="stop-arrow"><i data-lucide="chevron-right"></i></div>
                </a>
              `;
            }).join('')}
          </div>
        `;
      }

      container.innerHTML = html;
      createIcons({ icons: { Star, Heart, ChevronRight, Map } });

      // Add listeners to favorite route links to set target destination
      // Añadir oyentes a los enlaces de rutas favoritas para establecer la parada destino
      container.querySelectorAll('.favorite-route-link').forEach(link => {
        link.addEventListener('click', (e) => {
          const destId = link.getAttribute('data-dest');
          if (destId) {
            tracking.setTargetDestination(parseInt(destId));
          }
        });
      });
    }

    loadFavorites();

    window.addEventListener('catalog-loaded', () => {
      loadFavorites();
    });
  </script>
</Layout>

<style is:global>
  .stop-card-link, .route-fav-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    margin-bottom: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .route-fav-card {
    position: relative;
    border-left: none !important;
    overflow: hidden;
  }

  .route-fav-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background-color: var(--line-color, var(--primary));
  }

  .stop-lines {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.5rem;
  }

  .line-tag {
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: white;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .mt-2 { margin-top: 2rem; }

  .route-fav-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-grow: 1;
    min-width: 0;
  }

  .line-badge-small {
    color: white;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.85rem;
    min-width: 35px;
    text-align: center;
  }

  .route-fav-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .route-fav-text strong {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .route-fav-text small {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }

  .empty-state .icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
    opacity: 0.3;
  }
</style>
