---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { getTranslations } from "../utils/i18n";

const lang = Astro.cookies.get('buscoruna_lang')?.value || 'es';
const t = getTranslations(lang);

const postsEs = [
  {
    title: "La mejor aplicación de buses en Coruña: ¿Por qué elegir Coruña Bus?",
    slug: "mejor-aplicacion-buses-coruna",
    description: "Descubre por qué Coruña Bus es la herramienta definitiva para moverte por la ciudad. Tiempos reales, rutas optimizadas y privacidad total.",
    date: "2026-06-09"
  },
  {
    title: "Cómo ahorrar tiempo en tus trayectos de bus por A Coruña",
    slug: "ahorrar-tiempo-bus-coruna",
    description: "Trucos y consejos para usar el transporte público de Coruña como un experto. Evita esperas innecesarias con nuestra calculadora.",
    date: "2026-06-08"
  }
];

const postsEn = [
  {
    title: "The best bus app in Coruña: Why choose Coruña Bus?",
    slug: "mejor-aplicacion-buses-coruna",
    description: "Discover why Coruña Bus is the ultimate tool for getting around the city. Real-time arrival, optimized routes, and total privacy.",
    date: "2026-06-09"
  },
  {
    title: "How to save time on your bus trips in A Coruña",
    slug: "ahorrar-tiempo-bus-coruna",
    description: "Tips and tricks to use Coruña public transport like a pro. Avoid unnecessary waiting times with our route calculator.",
    date: "2026-06-08"
  }
];

const posts = lang === 'en' ? postsEn : postsEs;
---

<Layout title={lang === 'en' ? "Blog - Coruña Bus | News & Transport Guides" : "Blog - Coruña Bus | Noticias y Guías de Transporte"}>
  <div class="blog-container">
    <header class="blog-header">
      <h1>Blog Coruña<span>Bus</span></h1>
      <p>{lang === 'en' ? "Tips, news, and guides for getting around the city." : "Consejos, noticias y guías para moverte por la ciudad."}</p>
    </header>

    <div class="posts-grid">
      {posts.map(post => (
        <article class="card post-card">
          <h2>{post.title}</h2>
          <p class="post-desc">{post.description}</p>
          <div class="post-meta">
            <time>{post.date}</time>
            <a href={`/blog/${post.slug}`} class="read-more">{lang === 'en' ? "Read more" : "Leer más"}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style is:global>
  .blog-container {
    padding: 1rem 0;
  }
  .blog-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .blog-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
  }
  .blog-header h1 span {
    font-weight: 300;
    color: var(--primary);
  }
  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .post-card {
    padding: 2rem;
  }
  .post-card h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  .post-desc {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .post-meta time {
    font-size: 0.85rem;
    color: #888;
  }
  .read-more {
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
  }
</style>
