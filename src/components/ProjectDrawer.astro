---
import Icon from "./Icon.astro";
---

<div id="project-menu-overlay" class="project-menu-overlay">
    <div class="project-menu-content">
        <div class="project-menu-header">
            <h3>Nuestros Proyectos</h3>
            <button id="close-project-menu" class="close-btn">
                <Icon name="x" size={24} />
            </button>
        </div>
        <div id="project-list" class="project-list">
            <div class="loading-projects">Cargando proyectos...</div>
        </div>
        <div class="project-menu-footer">
            <p>Descubre más en <a href="https://inled.es" target="_blank">inled.es</a></p>
        </div>
    </div>
</div>

<style is:global>
    .project-menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 9000; /* High z-index to be above everything */
        display: none;
        justify-content: flex-end;
    }

    .project-menu-overlay.active {
        display: flex;
    }

    .project-menu-content {
        width: 100%;
        max-width: 350px;
        background: white;
        height: 100%;
        display: flex;
        flex-direction: column;
        animation: slideInProject 0.3s ease-out;
        box-shadow: -5px 0 15px rgba(0, 0, 0, 0.2);
    }

    @keyframes slideInProject {
        from {
            transform: translateX(100%);
        }
        to {
            transform: translateX(0);
        }
    }

    .project-menu-header {
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eee;
    }

    .project-menu-header h3 {
        margin: 0;
        font-size: 1.25rem;
        color: #1c212a;
    }

    .close-btn {
        background: none;
        border: none;
        color: #666;
        cursor: pointer;
        padding: 4px;
        display: flex;
    }

    .project-list {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .loading-projects {
        text-align: center;
        padding: 2rem;
        color: #666;
    }

    /* Target dynamic content with global styles */
    .project-card {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid #eee;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s, box-shadow 0.2s;
        background: white;
        align-items: center;
    }

    .project-card:active {
        transform: scale(0.98);
        background: #f9f9f9;
    }

    .project-logo {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .project-info {
        flex: 1;
        min-width: 0;
    }

    .project-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: 1rem;
        color: #1c212a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .project-info p {
        margin: 0;
        font-size: 0.85rem;
        color: #666;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-menu-footer {
        padding: 1.5rem;
        border-top: 1px solid #eee;
        text-align: center;
        font-size: 0.85rem;
        color: #666;
    }

    .project-menu-footer a {
        color: #f44336;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<script>
    interface Project {
        name: string;
        description: string;
        logo: string;
        link: string;
        type: string;
    }

    const closeBtn = document.getElementById('close-project-menu');
    const overlay = document.getElementById('project-menu-overlay');
    const projectList = document.getElementById('project-list');

    let projectsLoaded = false;

    async function fetchProjects() {
        if (projectsLoaded) return;
        
        try {
            const response = await fetch('https://inled.es/projects.json');
            const projects: Project[] = await response.json();
            
            if (projectList) {
                projectList.innerHTML = projects.map(project => `
                    <a href="${project.link}" target="_blank" class="project-card">
                        <img src="${project.logo}" alt="${project.name}" class="project-logo" />
                        <div class="project-info">
                            <h4>${project.name}</h4>
                            <p>${project.description}</p>
                        </div>
                    </a>
                `).join('');
                projectsLoaded = true;
            }
        } catch (error) {
            console.error('Error fetching projects:', error);
            if (projectList) {
                projectList.innerHTML = '<div class="loading-projects">Error al cargar los proyectos. Inténtalo más tarde.</div>';
            }
        }
    }

    // Listen for a custom event to open the drawer
    window.addEventListener('open-project-menu', () => {
        overlay?.classList.add('active');
        fetchProjects();
    });

    closeBtn?.addEventListener('click', () => {
        overlay?.classList.remove('active');
    });

    overlay?.addEventListener('click', (e) => {
        if (e.target === overlay) {
            overlay.classList.remove('active');
        }
    });
</script>
