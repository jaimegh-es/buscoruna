---
import { 
  RefreshCw, 
  Pencil, 
  Search, 
  MapPin, 
  Bus, 
  Star, 
  Heart, 
  Map as MapIcon, 
  X, 
  ChevronRight, 
  ChevronLeft,
  LocateFixed,
  ShieldCheck,
  Ban,
  Menu,
  Share,
  Plus,
  Home,
  Settings,
  Navigation2,
  Maximize2,
  Minimize2,
  Camera,
  Download,
  ChevronDown,
  Minus,
  Briefcase,
  Clock,
  Trash2
} from '@lucide/astro';

interface Props {
  name: 'refresh' | 'edit' | 'settings' | 'search' | 'stop' | 'bus' | 'star' | 'heart' | 'map' | 'x' | 'chevron-right' | 'chevron-left' | 'chevron-down' | 'location' | 'star-outline' | 'heart-outline' | 'shield' | 'ban' | 'menu' | 'share' | 'plus' | 'minus' | 'home' | 'briefcase' | 'clock' | 'trash' | 'maximize' | 'minimize' | 'street-view' | 'navigation' | 'download';
  class?: string;
  size?: number;
}

const { name, class: className, size = 24 } = Astro.props;

const iconMap = {
  refresh: RefreshCw,
  edit: Pencil,
  settings: Settings,
  search: Search,
  stop: MapPin,
  bus: Bus,
  star: Star,
  heart: Heart,
  map: MapIcon,
  x: X,
  'chevron-right': ChevronRight,
  'chevron-left': ChevronLeft,
  'chevron-down': ChevronDown,
  location: LocateFixed,
  'star-outline': Star,
  'heart-outline': Heart,
  shield: ShieldCheck,
  ban: Ban,
  menu: Menu,
  share: Share,
  plus: Plus,
  minus: Minus,
  home: Home,
  briefcase: Briefcase,
  clock: Clock,
  trash: Trash2,
  maximize: Maximize2,
  minimize: Minimize2,
  'street-view': Camera,
  navigation: Navigation2,
  download: Download
};

const SelectedIcon = iconMap[name];
const isOutline = name.endsWith('-outline');
---

{SelectedIcon && (
  <SelectedIcon 
    class={className} 
    size={size} 
    fill={isOutline ? "none" : (name === 'star' || name === 'heart' ? "currentColor" : "none")}
  />
)}
