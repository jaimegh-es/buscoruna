<script>
  import { API } from '../services/api';
  import { storage } from '../utils/storage';

  async function loadCatalog() {
    const existing = storage.getCatalog();
    
    // Force refresh if missing or has old structure (paradas as array)
    const isOldStructure = existing && (Array.isArray(existing.paradas) || !existing.paradas || Object.keys(existing.paradas).length === 0);
    
    if (!existing || isOldStructure) {
      try {
        const catalog = await API.getCatalog();
        if (catalog && (catalog.resultado === 'OK' || catalog.iTranvias)) {
          const raw = catalog.iTranvias || catalog;
          
          const paradasRecord: any = {};
          let stopCount = 0;
          const paradasList = (raw && Array.isArray(raw.paradas) && raw.paradas) || 
                              (raw && raw.actualizacion && Array.isArray(raw.actualizacion.paradas) && raw.actualizacion.paradas) || [];
          
          paradasList.forEach((s: any) => {
            if (s && s.id !== undefined) {
              paradasRecord[s.id] = s;
              paradasRecord[String(s.id)] = s;
              stopCount++;
            }
          });

          const transformedCatalog = {
            actualizacion: raw.actualizacion || raw,
            paradas: paradasRecord
          };

          storage.setCatalog(transformedCatalog);
          window.dispatchEvent(new CustomEvent('catalog-loaded'));
        }
      } catch (err) {
        console.error('Failed to load catalog:', err);
      }
    }
  }

  // Load on start
  loadCatalog();
</script>
