    setupMapModal() {
      const closeBtn = this.querySelector('#close-map');
      const confirmBtn = this.querySelector('#confirm-selection');
      
      closeBtn?.addEventListener('click', () => this.closeMap());
      confirmBtn?.addEventListener('click', () => this.confirmMapSelection());
    }

    openMap(target: 'origin' | 'destination') {
      this.currentSelectionTarget = target;
      const modal = this.querySelector('#map-modal') as HTMLElement;
      modal.style.display = 'block';

      if (!this.map) {
        // @ts-ignore
        this.map = L.map('selection-map').setView([43.3623, -8.4115], 13);
        // @ts-ignore
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OSM'
        }).addTo(this.map);
      }

      setTimeout(() => {
        this.map.invalidateSize();
        
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition((pos) => {
            const { latitude, longitude } = pos.coords;
            this.map.setView([latitude, longitude], 16);
            this.showNearbyStopsOnMap(latitude, longitude);
          }, (err) => {
            console.error('Geolocation error:', err);
            this.showNearbyStopsOnMap(43.3623, -8.4115);
          }, { enableHighAccuracy: true });
        } else {
          this.showNearbyStopsOnMap(43.3623, -8.4115);
        }
      }, 200);
    }

    showNearbyStopsOnMap(lat: number, lon: number) {
      if (!this.catalog) this.catalog = storage.getCatalog();
      if (!this.catalog || !this.catalog.paradas) return;

      this.markers.forEach(m => m.remove());
      this.markers = [];

      const stops = Object.values(this.catalog.paradas);
      const nearby = stops
        .map((s: any) => ({
          ...s,
          dist: this.getDistance(lat, lon, s.posy, s.posx)
        }))
        .sort((a, b) => a.dist - b.dist)
        .slice(0, 30);

      nearby.forEach((s: any) => {
        // @ts-ignore
        const marker = L.marker([s.posy, s.posx]).addTo(this.map);
        marker.bindPopup(`<strong>${s.nombre}</strong><br>${lang === 'en' ? 'Stop' : 'Parada'} ${s.id}`);
        marker.on('click', () => {
          this.tempSelectedStop = s;
          const info = this.querySelector('#selected-stop-info');
          if (info) info.innerHTML = lang === 'en' ? `Selected: <strong>${s.nombre}</strong>` : `Seleccionada: <strong>${s.nombre}</strong>`;
          const confirmBtn = this.querySelector('#confirm-selection') as HTMLButtonElement;
          if (confirmBtn) confirmBtn.disabled = false;
        });
        this.markers.push(marker);
      });
    }


    confirmMapSelection() {
      if (!this.tempSelectedStop || !this.currentSelectionTarget) return;
      
      const input = this.querySelector(`#${this.currentSelectionTarget}`) as HTMLInputElement;
      input.value = this.tempSelectedStop.nombre;
      
      if (this.currentSelectionTarget === 'origin') this.selectedOrigin = { type: 'stop', ...this.tempSelectedStop };
      else this.selectedDestination = { type: 'stop', ...this.tempSelectedStop };
      
      this.closeMap();
    }

    closeMap() {
      const modal = this.querySelector('#map-modal') as HTMLElement;
      modal.style.display = 'none';
      this.tempSelectedStop = null;
      this.currentSelectionTarget = null;
      const confirmBtn = this.querySelector('#confirm-selection') as HTMLButtonElement;
      if (confirmBtn) confirmBtn.disabled = true;
      const info = this.querySelector('#selected-stop-info');
      if (info) info.textContent = lang === 'en' ? 'Tap a stop on the map' : 'Toca una parada en el mapa';
    }


    setupAutocomplete(inputId: string) {
      const input = this.querySelector(`#${inputId}`) as HTMLInputElement;
      const resultsDiv = this.querySelector(`#${inputId}-results`) as HTMLDivElement;
      let timeout: any = null;

      input?.addEventListener('input', () => {
        clearTimeout(timeout);
        const query = input.value.trim().toLowerCase();
        
        if (query.length < 3) {
          resultsDiv.style.display = 'none';
          return;
        }

        resultsDiv.innerHTML = `
          <div class="autocomplete-loading">
            <div class="spinner-small"></div>
            <span>${lang === 'en' ? 'Searching...' : 'Buscando...'}</span>
          </div>
        `;
        resultsDiv.style.display = 'block';

        timeout = setTimeout(async () => {
          this.catalog = storage.getCatalog();
          
          let matchedStops: any[] = [];
          if (this.catalog && this.catalog.paradas) {
            const stops = Object.values(this.catalog.paradas);
            matchedStops = stops
              .filter((s: any) => 
                s.nombre.toLowerCase().includes(query) || 
                s.id.toString().includes(query)
              )
              .slice(0, 3);
          }

          let places: any[] = [];
          try {
            places = await Geocoding.search(query);
          } catch (err) {
            console.error('Geocoding search failed:', err);
          }

          if (matchedStops.length > 0 || places.length > 0) {
            resultsDiv.innerHTML = `
              ${matchedStops.map((s: any) => `
                <div class="autocomplete-item stop" data-type="stop" data-id="${s.id}" data-name="${s.nombre}">
                  <span class="icon"><i data-lucide="map-pin" style="width: 18px; height: 18px;"></i></span>
                  <div class="info">
                    <strong>${s.nombre}</strong>
                    <small>${lang === 'en' ? 'Stop' : 'Parada'} ${s.id}</small>
                  </div>
                </div>
              `).join('')}
              ${places.map((p: any) => `
                <div class="autocomplete-item place" data-type="place" data-lat="${p.lat}" data-lon="${p.lon}" data-name="${p.full_name}">
                  <span class="icon"><i data-lucide="navigation" style="width: 18px; height: 18px;"></i></span>
                  <div class="info">
                    <strong>${p.name}</strong>
                    <small>${p.full_name}</small>
                  </div>
                </div>
              `).join('')}
            `;
            resultsDiv.style.display = 'block';
            this.renderIcons();

            resultsDiv.querySelectorAll('.autocomplete-item').forEach(item => {
              item.addEventListener('click', () => {
                const type = item.getAttribute('data-type');
                const name = item.getAttribute('data-name');
                input.value = name || '';
                resultsDiv.style.display = 'none';
                
                const currentCatalog = storage.getCatalog();
                if (type === 'stop') {
                  const id = item.getAttribute('data-id');
                  const stop = currentCatalog?.paradas[id!];
                  if (inputId === 'origin') this.selectedOrigin = { type: 'stop', ...stop };
                  else this.selectedDestination = { type: 'stop', ...stop };
                } else {
                  const lat = parseFloat(item.getAttribute('data-lat') || '0');
                  const lon = parseFloat(item.getAttribute('data-lon') || '0');
                  const place = {
                    type: 'place',
                    nombre: name,
                    posy: lat,
                    posx: lon
                  };
                  if (inputId === 'origin') this.selectedOrigin = place;
                  else this.selectedDestination = place;
                }
              });
            });
          } else if (query.length >= 3) {
            resultsDiv.innerHTML = `<div class="autocomplete-item"><small>${t.tripNoResultsQuery.replace('{query}', query)}</small></div>`;
            resultsDiv.style.display = 'block';
          } else {
            resultsDiv.style.display = 'none';
          }
        }, 300);
      });

      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) {
          resultsDiv.style.display = 'none';
        }
      });
    }

    findClosestStop(lat: number, lon: number) {
      if (!this.catalog) this.catalog = storage.getCatalog();
      const stops = Object.values(this.catalog.paradas);
      let closest = null;
      let minDist = Infinity;
      
      stops.forEach((s: any) => {
        const d = this.getDistance(lat, lon, s.posy, s.posx);
        if (d < minDist) {
          minDist = d;
          closest = s;
        }
      });
      return closest;
    }

    async calculate() {
      if (!this.selectedOrigin || !this.selectedDestination) {
        alert(t.tripSelectOriginDest);
        return;
      }

      const resultsDiv = this.querySelector('#results') as HTMLDivElement;
      if (resultsDiv) resultsDiv.innerHTML = `<div class="loading">${lang === 'en' ? 'Calculating the best combination...' : 'Buscando la mejor combinación...'}</div>`;

      this.catalog = storage.getCatalog();
      if (!this.catalog || !this.catalog.actualizacion || !this.catalog.actualizacion.lineas) {
        console.error('Catalog not loaded or invalid structure', this.catalog);
        if (resultsDiv) resultsDiv.innerHTML = '<div class="error">Error: El catálogo de líneas no está disponible.</div>';
        return;
      }

      const allLines = this.catalog.actualizacion.lineas;
      const allStopsArray = Object.values(this.catalog.paradas);

      // Prepare origin and destination stops
      let originStops = [];
      if (this.selectedOrigin.type === 'stop') {
        originStops.push({ ...this.selectedOrigin, walkDist: 0 });
      } else {
        // Find stops near place
        originStops = this.findNearbyStops(this.selectedOrigin.posy, this.selectedOrigin.posx, 800)
          .map(s => ({ ...s, walkDist: s.dist }));
      }

      let destStops = [];
      if (this.selectedDestination.type === 'stop') {
        destStops.push({ ...this.selectedDestination, walkDist: 0 });
      } else {
        // Find stops near place
        destStops = this.findNearbyStops(this.selectedDestination.posy, this.selectedDestination.posx, 1000)
          .map(s => ({ ...s, walkDist: s.dist }));
      }

      console.log(`Found ${originStops.length} origin stops and ${destStops.length} destination stops`);

      let directRoutes: any[] = [];
      let nearbyRoutes: any[] = [];
      
      for (const oStop of originStops) {
        for (const dStop of destStops) {
          const routes = this.findDirectRoutes(parseInt(oStop.id), parseInt(dStop.id), allLines);
          routes.forEach(r => {
            const totalWalk = oStop.walkDist + dStop.walkDist;
            const routeObj = {
              ...r,
              originStop: oStop,
              destStop: dStop,
              walkDist: totalWalk,
              walkToOrigin: Math.round(oStop.walkDist),
              walkToDest: Math.round(dStop.walkDist),
              isNearby: totalWalk > 100 
            };

            if (totalWalk < 150) {
              if (!directRoutes.find(dr => dr.lineId === r.lineId)) {
                directRoutes.push(routeObj);
              }
            } else {
              if (totalWalk < 1500) {
                nearbyRoutes.push(routeObj);
              }
            }
          });
        }
      }

      console.log(`Found ${directRoutes.length} direct routes and ${nearbyRoutes.length} nearby routes`);

      let transferRoutes: any[] = [];
      if (directRoutes.length < 2) {
        // Try transfers between the top origin and destination stops
        const topO = originStops.slice(0, 3);
        const topD = destStops.slice(0, 3);
        
        for (const oStop of topO) {
          for (const dStop of topD) {
            const routes = this.findTransferRoutes(parseInt(oStop.id), parseInt(dStop.id), allLines, allStopsArray);
            routes.forEach(r => {
              const totalWalk = oStop.walkDist + dStop.walkDist;
              const routeObj = {
                 ...r,
                 type: 'transfer',
                 walkDist: totalWalk,
                 walkToOrigin: Math.round(oStop.walkDist),
                 walkToDest: Math.round(dStop.walkDist)
              };
              // Deduplicate by line combination and transfer stop
              const key = `${r.l1.id}-${r.l2.id}-${r.transferStop.id}`;
              if (!transferRoutes.find(tr => `${tr.l1.id}-${tr.l2.id}-${tr.transferStop.id}` === key)) {
                transferRoutes.push(routeObj);
              }
            });
          }
        }
      }
      
      transferRoutes.sort((a, b) => (a.totalStops * 2 + a.walkDist/50) - (b.totalStops * 2 + b.walkDist/50));
      console.log(`Found ${transferRoutes.length} transfer routes`);

      if (directRoutes.length === 0 && nearbyRoutes.length === 0 && transferRoutes.length === 0) {
        if (resultsDiv) resultsDiv.innerHTML = `
          <div class="empty-state">
            <p>${lang === 'en' ? 'No route found between these locations.' : 'No se encontró una ruta entre estas ubicaciones.'}</p>
            <small>${lang === 'en' ? 'Try selecting other points of interest or nearby stops.' : 'Intenta seleccionar otros puntos de interés o paradas cercanas.'}</small>
          </div>
        `;
        return;
      }

      directRoutes.sort((a, b) => a.stopsCount - b.stopsCount);
      nearbyRoutes.sort((a, b) => (a.stopsCount * 2 + a.walkDist/50) - (b.stopsCount * 2 + b.walkDist/50));
      
      const uniqueNearby: any[] = [];
      nearbyRoutes.forEach(nr => {
        const existing = uniqueNearby.find(u => u.lineId === nr.lineId);
        if (!existing) uniqueNearby.push(nr);
        else if (nr.walkDist < existing.walkDist) {
          uniqueNearby[uniqueNearby.indexOf(existing)] = nr;
        }
      });
      nearbyRoutes = uniqueNearby;

      this.lastResults = [
        ...directRoutes.map(r => ({ ...r, type: 'direct' })),
        ...nearbyRoutes.map(r => ({ ...r, type: 'nearby' })),
        ...transferRoutes.map(r => ({ ...r, type: 'transfer' }))
      ];

      if (resultsDiv) {
        const isFav = storage.isFavoritePlannerRoute(this.selectedOrigin, this.selectedDestination);
        resultsDiv.innerHTML = `
          <div class="route-summary-header">
            <h3>${lang === 'en' ? 'Routes from' : 'Rutas de'} <strong>${this.selectedOrigin.nombre}</strong> ${lang === 'en' ? 'to' : 'a'} <strong>${this.selectedDestination.nombre}</strong></h3>
            <button type="button" id="toggle-fav-planner-route-btn" class="fav-planner-route-btn" title="${t.tripSaveToFavsTitle}">
              ${isFav 
                ? `<i data-lucide="star" style="fill: currentColor; color: #facc15; width: 22px; height: 22px;"></i>` 
                : `<i data-lucide="star" style="width: 22px; height: 22px;"></i>`
              }
            </button>
          </div>
          <div id="taxi-warning" style="display: none; padding: 1rem; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; margin-bottom: 1.5rem; color: #92400e; font-style: italic; text-align: center;">
             ${lang === 'en' ? '🚕 Looks like you might need to take a taxi...' : '🚕 Pues va a haber que coger un taxi...'}
          </div>
          <div class="results-list">
            ${directRoutes.slice(0, 3).map((l, i) => this.renderDirectRouteCard(l, i)).join('')}
            ${nearbyRoutes.slice(0, 3).map((l, i) => this.renderNearbyRouteCard(l, i + directRoutes.length)).join('')}
            ${transferRoutes.slice(0, 2).map((l, i) => this.renderTransferRouteCard(l, i + directRoutes.length + nearbyRoutes.length)).join('')}
          </div>
        `;


        
        // Add click listeners to result cards (for map)
        resultsDiv.querySelectorAll('.result-card').forEach(card => {
          card.addEventListener('click', (e) => {
            // Don't open map if clicking a button or link
            if ((e.target as HTMLElement).closest('button, a')) return;
            
            const idx = parseInt(card.getAttribute('data-idx') || '0');
            const route = this.lastResults[idx];
            if (route) this.showRouteOnMap(route);
          });
        });

        // Add 'Ver parada' listeners to save destination
        resultsDiv.querySelectorAll('.btn-view-stop').forEach(btn => {
          btn.addEventListener('click', () => {
            const destId = btn.getAttribute('data-dest');
            if (destId) {
              import('../utils/tracking').then(({ tracking }) => {
                tracking.setTargetDestination(parseInt(destId));
              });
            }
          });
        });

        // Add track route listeners
        resultsDiv.querySelectorAll('.btn-track-route').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const lineId = parseInt(btn.getAttribute('data-line')!);
            const originId = parseInt(btn.getAttribute('data-origin')!);
            const destId = parseInt(btn.getAttribute('data-dest')!);
            
            try {
              const data = await API.getStopArrivals(originId);
              if (data.resultado === 'OK' && data.buses && data.buses.lineas) {
                const lineInfo = data.buses.lineas.find((bl: any) => bl.linea.toString() === lineId.toString());
                if (lineInfo && lineInfo.buses && lineInfo.buses.length > 0) {
                  const bus = lineInfo.buses[0];
                  if (bus.bus) {
                    import('../utils/tracking').then(({ tracking }) => {
                      tracking.set({
                        busId: bus.bus.toString(),
                        lineId: lineId,
                        destinationStopId: destId,
                        originStopId: originId,
                        lastEta: null,
                        arrivalTime: null
                      });
                      alert(`¡Seguimiento iniciado para el bus ${bus.bus}!`);
                    });
                  } else {
                    alert('No se pudo identificar el número de bus para seguimiento.');
                  }
                } else {
                  alert('No hay buses próximos para esta línea en este momento.');
                }
              }
            } catch (err) {
              alert('Error al obtener datos de tiempo real.');
            }
          });
        });

        const toFetch = [...directRoutes.slice(0,2), ...nearbyRoutes.slice(0,2)];
        this.fetchRealTime(toFetch);

        // Add favorite button listeners
        resultsDiv.querySelectorAll('.fav-route-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const origin = parseInt(btn.getAttribute('data-origin')!);
            const dest = parseInt(btn.getAttribute('data-dest')!);
            const line = parseInt(btn.getAttribute('data-line')!);
            const lineName = btn.getAttribute('data-line-name')!;
            
            storage.toggleFavoriteRoute(origin, dest, line, lineName);
            
            // Check if it is now a favorite
            // Comprobar si ahora es favorita
            const favRoutes = storage.getFavoriteRoutes();
            const routeId = `${origin}-${dest}-${line}`;
            const isNowFav = favRoutes.some((f: any) => f.routeId === routeId);

            // Re-render and re-hydrate the icon
            // Volver a renderizar e hidratar el icono
            btn.innerHTML = `<i data-lucide="heart" style="width: 20px; height: 20px; fill: ${isNowFav ? 'currentColor' : 'none'}"></i>`;
            this.renderIcons();
          });
        });

        this.renderIcons();

        // Toggle planner route in favorites listener
        // Manejador para alternar la ruta planificada en favoritos
        const favBtn = resultsDiv.querySelector('#toggle-fav-planner-route-btn');
        if (favBtn) {
          favBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            
            const isNowFav = storage.isFavoritePlannerRoute(this.selectedOrigin, this.selectedDestination);
            
            if (isNowFav) {
              // Already a favorite, toggle it off directly
              // Ya es favorito, quitar de favoritos directamente
              storage.toggleFavoritePlannerRoute(this.selectedOrigin, this.selectedDestination);
              favBtn.innerHTML = '<i data-lucide="star" style="width: 22px; height: 22px;"></i>';
              this.renderIcons();
            } else {
              // Not a favorite. Check if we have an arrival time set to ask the user.
              // No es favorito. Comprobar si se ha establecido hora de llegada para preguntar al usuario.
              const targetTimeInput = this.querySelector('#target-time') as HTMLInputElement;
              const targetTime = targetTimeInput?.value;
              
              if (this.plannerMode === 'arrive' && targetTime) {
                // Open confirmation dialog
                // Abrir diálogo de confirmación
                const modal = this.querySelector('#save-time-modal') as HTMLElement;
                const timeDisplay = this.querySelector('#save-time-modal-display') as HTMLElement;
                
                if (timeDisplay) timeDisplay.textContent = targetTime;
                if (modal) modal.style.display = 'block';
                
                // Configure modal buttons
                // Configurar botones del modal
                const saveWithTimeBtn = this.querySelector('#btn-save-with-time');
                const saveWithoutTimeBtn = this.querySelector('#btn-save-without-time');
                const closeSaveTimeBtn = this.querySelector('#close-save-time');
                
                const onSaveWithTime = () => {
                  storage.toggleFavoritePlannerRoute(this.selectedOrigin, this.selectedDestination, 'arrive', targetTime);
                  favBtn.innerHTML = '<i data-lucide="star" style="fill: currentColor; color: #facc15; width: 22px; height: 22px;"></i>';
                  this.renderIcons();
                  cleanup();
                };
                
                const onSaveWithoutTime = () => {
                  storage.toggleFavoritePlannerRoute(this.selectedOrigin, this.selectedDestination, 'now', null);
                  favBtn.innerHTML = '<i data-lucide="star" style="fill: currentColor; color: #facc15; width: 22px; height: 22px;"></i>';
                  this.renderIcons();
                  cleanup();
                };
                
                const onCancel = () => {
                  cleanup();
                };
                
                const cleanup = () => {
                  if (modal) modal.style.display = 'none';
                  saveWithTimeBtn?.removeEventListener('click', onSaveWithTime);
                  saveWithoutTimeBtn?.removeEventListener('click', onSaveWithoutTime);
                  closeSaveTimeBtn?.removeEventListener('click', onCancel);
                  modal?.removeEventListener('click', onModalClick);
                };

                const onModalClick = (event: MouseEvent) => {
                  if (event.target === modal) {
                    cleanup();
                  }
                };
                
                saveWithTimeBtn?.addEventListener('click', onSaveWithTime);
                saveWithoutTimeBtn?.addEventListener('click', onSaveWithoutTime);
                closeSaveTimeBtn?.addEventListener('click', onCancel);
                modal?.addEventListener('click', onModalClick);
                
              } else {
                // No target time or in "now" mode, save directly
                // Sin hora de llegada o en modo "ahora", guardar directamente
                storage.toggleFavoritePlannerRoute(this.selectedOrigin, this.selectedDestination, 'now', null);
                favBtn.innerHTML = '<i data-lucide="star" style="fill: currentColor; color: #facc15; width: 22px; height: 22px;"></i>';
                this.renderIcons();
              }
            }
          });

        }
      }
    }

    async showRouteOnMap(route: any) {
      const modal = this.querySelector('#route-detail-modal') as HTMLElement;
      const detailInfo = this.querySelector('#route-detail-info') as HTMLElement;
      modal.style.display = 'block';

      if (!this.routeMap) {
        // @ts-ignore
        this.routeMap = L.map('route-map').setView([43.3623, -8.4115], 14);
        // @ts-ignore
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OSM'
        }).addTo(this.routeMap);
      }

      setTimeout(async () => {
        this.routeMap.invalidateSize();
        this.routeMarkers.forEach(m => m.remove());
        this.routeMarkers = [];

        // @ts-ignore
        const bounds = L.latLngBounds([]);

        if (route.type === 'direct' || route.type === 'nearby') {
          // @ts-ignore
          const m1 = L.marker([route.originStop.posy, route.originStop.posx]).addTo(this.routeMap).bindPopup(`${lang === 'en' ? 'Board here' : 'Sube aquí'}: ${route.originStop.nombre}`);
          // @ts-ignore
          const m2 = L.marker([route.destStop.posy, route.destStop.posx]).addTo(this.routeMap).bindPopup(`${lang === 'en' ? 'Get off here' : 'Bájate aquí'}: ${route.destStop.nombre}`);
          this.routeMarkers.push(m1, m2);
          bounds.extend([route.originStop.posy, route.originStop.posx]);
          bounds.extend([route.destStop.posy, route.destStop.posx]);

          this.fetchBusPath(route.originStop, route.destStop, route.color);

          if (this.selectedOrigin.type === 'place' && route.walkToOrigin > 30) {
             // @ts-ignore
             const m0 = L.marker([this.selectedOrigin.posy, this.selectedOrigin.posx], { icon: L.icon({ iconUrl: 'https://cdn-icons-png.flaticon.com/512/25/25694.png', iconSize: [25, 25] }) }).addTo(this.routeMap).bindPopup(lang === 'en' ? "Your origin" : "Tu origen");
             this.routeMarkers.push(m0);
             bounds.extend([this.selectedOrigin.posy, this.selectedOrigin.posx]);
             this.drawWalkingPath(this.selectedOrigin.posy, this.selectedOrigin.posx, route.originStop.posy, route.originStop.posx, 'origin');
          }

          if (this.selectedDestination.type === 'place' && route.walkToDest > 30) {
             // @ts-ignore
             const m3 = L.marker([this.selectedDestination.posy, this.selectedDestination.posx], { icon: L.icon({ iconUrl: 'https://cdn-icons-png.flaticon.com/512/25/25694.png', iconSize: [25, 25] }) }).addTo(this.routeMap).bindPopup(lang === 'en' ? "Your destination" : "Tu destino");
             this.routeMarkers.push(m3);
             bounds.extend([this.selectedDestination.posy, this.selectedDestination.posx]);
             this.drawWalkingPath(route.destStop.posy, route.destStop.posx, this.selectedDestination.posy, this.selectedDestination.posx, 'destination');
          }

          detailInfo.innerHTML = `
            <div style="display: flex; gap: 1rem; align-items: center;">
              <span class="line-badge" style="background-color: #${route.color}">${route.lineComer}</span>
              <div>
                <p><strong>${route.originStop.nombre}</strong> &rarr; <strong>${route.destStop.nombre}</strong></p>
                <p><small>${route.stopsCount} ${lang === 'en' ? 'stops' : 'paradas'} (~${route.estimatedTravelMins} min)</small></p>
                <p><small id="walking-time-info"></small></p>
              </div>
            </div>
          `;

        } else if (route.type === 'transfer') {
          // @ts-ignore
          const m1 = L.marker([this.selectedOrigin.posy, this.selectedOrigin.posx]).addTo(this.routeMap).bindPopup(`Sube aquí: ${this.selectedOrigin.nombre}`);
          // @ts-ignore
          const m2 = L.marker([route.transferStop.posy, route.transferStop.posx]).addTo(this.routeMap).bindPopup(`Trasbordo: ${route.transferStop.nombre}`);
          // @ts-ignore
          const m3 = L.marker([this.selectedDestination.posy, this.selectedDestination.posx]).addTo(this.routeMap).bindPopup(`Bájate aquí: ${this.selectedDestination.nombre}`);
          this.routeMarkers.push(m1, m2, m3);
          bounds.extend([this.selectedOrigin.posy, this.selectedOrigin.posx]);
          bounds.extend([route.transferStop.posy, route.transferStop.posx]);
          bounds.extend([this.selectedDestination.posy, this.selectedDestination.posx]);

          this.fetchBusPath(this.selectedOrigin, route.transferStop, route.l1.color);
          this.fetchBusPath(route.transferStop, this.selectedDestination, route.l2.color);

          detailInfo.innerHTML = `
            <div>
              <p>1. Línea <strong>${route.l1.lin_comer}</strong> hasta <strong>${route.transferStop.nombre}</strong></p>
              <p>2. Línea <strong>${route.l2.lin_comer}</strong> hasta <strong>${this.selectedDestination.nombre}</strong></p>
            </div>
          `;
        }

        this.routeMap.fitBounds(bounds, { padding: [50, 50] });
      }, 200);
    }

    async fetchBusPath(s1: any, s2: any, color: string) {
       try {
         const response = await fetch(`https://router.project-osrm.org/route/v1/driving/${s1.posx},${s1.posy};${s2.posx},${s2.posy}?overview=full&geometries=geojson`);
         const data = await response.json();
         if (data.routes && data.routes[0]) {
            // @ts-ignore
            const layer = L.geoJSON(data.routes[0].geometry, { style: { color: `#${color}`, weight: 6 } }).addTo(this.routeMap);
            this.routeMarkers.push(layer);
         }
       } catch (e) {}
    }

    async drawWalkingPath(lat1: number, lon1: number, lat2: number, lon2: number, tag: 'origin' | 'destination') {
      try {
        const response = await fetch(`https://router.project-osrm.org/route/v1/walking/${lon1},${lat1};${lon2},${lat2}?overview=full&geometries=geojson`);
        const data = await response.json();
        if (data.routes && data.routes[0]) {
          const route = data.routes[0];
          // @ts-ignore
          const pathLayer = L.geoJSON(route.geometry, { style: { color: 'gray', dashArray: '5, 10', weight: 3 } }).addTo(this.routeMap);
          this.routeMarkers.push(pathLayer);
          
          const timeInfo = document.getElementById('walking-time-info');
          if (timeInfo) {
            const mins = Math.round(route.duration / 60);
            const dist = Math.round(route.distance);
            const prefix = tag === 'origin' 
              ? (lang === 'en' ? "Walk to stop: " : "Camina hasta la parada: ") 
              : (lang === 'en' ? "From stop walk: " : "Desde la parada camina: ");
            timeInfo.innerHTML += `<div>${prefix} ${dist}m (${mins} min)</div>`;
          }
        }
      } catch (err) {
        console.error('OSRM Error:', err);
      }
    }

    findDirectRoutes(originId: number, destId: number, lines: any[]) {
      const results: any[] = [];
      const sOriginId = originId.toString();
      const sDestId = destId.toString();

      lines.forEach((line: any) => {
        if (!line.rutas) return;
        line.rutas.forEach((route: any) => {
          const originIdx = route.paradas.findIndex((p: any) => p.toString() === sOriginId);
          const destIdx = route.paradas.findIndex((p: any) => p.toString() === sDestId);
          
          if (originIdx !== -1 && destIdx !== -1 && originIdx < destIdx) {
            const stopsCount = destIdx - originIdx;
            if (!results.find(r => r.lineId === line.id)) {
              results.push({
                lineId: line.id,
                lineComer: line.lin_comer,
                color: line.color,
                stopsCount,
                estimatedTravelMins: stopsCount * 2,
                originStop: this.catalog.paradas[sOriginId],
                destStop: this.catalog.paradas[sDestId]
              });
            }
          }
        });
      });
      return results;
    }

    findTransferRoutes(originId: number, destId: number, lines: any[], stops: any[]) {
      const results: any[] = [];
      const sOriginId = originId.toString();
      const sDestId = destId.toString();
      
      const originStop = stops.find(s => s.id.toString() === sOriginId);
      const destStop = stops.find(s => s.id.toString() === sDestId);
      if (!originStop || !destStop) return [];

      const linesAtOrigin = originStop.enlaces;
      const linesAtDest = destStop.enlaces;

      linesAtOrigin.forEach((l1Id: any) => {
        const line1 = lines.find(l => l.id.toString() === l1Id.toString());
        if (!line1) return;

        line1.rutas.forEach((r1: any) => {
          const oIdx = r1.paradas.findIndex((p: any) => p.toString() === sOriginId);
          if (oIdx === -1) return;

          // Look for potential transfer stops (major stops or any stop with connections)
          for (let i = oIdx + 1; i < r1.paradas.length; i++) {
            const transferStopId = r1.paradas[i];
            const transferStop = stops.find(s => s.id.toString() === transferStopId.toString());
            if (!transferStop || transferStopId.toString() === sDestId) continue;

            const linesAtTransfer = transferStop.enlaces;
            // Lines that are at the transfer stop AND at the destination stop
            const commonLines = linesAtTransfer.filter((lId: any) => 
              linesAtDest.some((d: any) => d.toString() === lId.toString())
            );

            commonLines.forEach((l2Id: any) => {
              if (l2Id.toString() === l1Id.toString()) return;
              const line2 = lines.find(l => l.id.toString() === l2Id.toString());
              if (!line2) return;

              line2.rutas.forEach((r2: any) => {
                const tIdx = r2.paradas.findIndex((p: any) => p.toString() === transferStopId.toString());
                const dIdx = r2.paradas.findIndex((p: any) => p.toString() === sDestId);

                if (tIdx !== -1 && dIdx !== -1 && tIdx < dIdx) {
                  // Found a connection!
                  const transferKey = `${line1.id}-${line2.id}-${transferStopId}`;
                  if (!results.find(r => `${r.l1.id}-${r.l2.id}-${r.transferStop.id}` === transferKey)) {
                    results.push({
                      l1: line1,
                      l2: line2,
                      transferStop: transferStop,
                      stops1: i - oIdx,
                      stops2: dIdx - tIdx,
                      totalStops: (i - oIdx) + (dIdx - tIdx),
                      originStop: originStop,
                      destStop: destStop
                    });
                  }
                }
              });
            });
          }
        });
      });

      // Sort by total stops and take the best few
      return results.sort((a, b) => a.totalStops - b.totalStops).slice(0, 4);
    }

    findNearbyStops(lat: number, lon: number, radiusMeters: number) {
      if (!this.catalog) this.catalog = storage.getCatalog();
      if (!this.catalog || !this.catalog.paradas) {
        console.warn('findNearbyStops: Catalog or paradas missing');
        return [];
      }
      
      const stops = Object.values(this.catalog.paradas);
      console.log(`Searching in ${stops.length} stops...`);

      const results = stops
        .map((s: any) => {
          // Force numbers to avoid string concatenation or NaN issues
          const sLat = parseFloat(s.posy as any);
          const sLon = parseFloat(s.posx as any);
          
          if (isNaN(sLat) || isNaN(sLon)) return { ...s, dist: Infinity };
          
          return {
            ...s,
            dist: this.getDistance(lat, lon, sLat, sLon)
          };
        })
        .filter((s: any) => s.dist <= radiusMeters)
        .sort((a: any, b: any) => a.dist - b.dist);

      console.log(`findNearbyStops at ${lat}, ${lon} (r=${radiusMeters}m): found ${results.length} stops`);
      return results;
    }

    getDistance(lat1: number, lon1: number, lat2: number, lon2: number) {
      const R = 6371000;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

