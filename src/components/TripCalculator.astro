                    <small>${lang === 'en' ? 'Use GPS coordinates' : 'Usar coordenadas GPS'}</small>
                  </div>
                </div>
                <div style="padding: 0.5rem 1rem; background: #f3f4f6; font-size: 0.75rem; font-weight: 700; color: #6b7280; text-transform: uppercase;">${lang === 'en' ? 'Nearby stops' : 'Paradas cercanas'}</div>
                ${nearby.map((s: any) => `
                  <div class="autocomplete-item stop" data-type="stop" data-id="${s.id}" data-name="${s.nombre}">
                    <span class="icon"><i data-lucide="map-pin" style="width: 18px; height: 18px;"></i></span>
                    <div class="info">
                      <strong>${s.nombre}</strong>
                      <small>${lang === 'en' ? 'Stop' : 'Parada'} ${s.id} (${Math.round(s.dist)}m)</small>
                    </div>
                  </div>
                `).join('')}
              `;
              this.renderIcons();

              resultsDiv.querySelectorAll('.autocomplete-item').forEach(item => {
                item.addEventListener('click', () => {
