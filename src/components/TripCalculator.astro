    async fetchRealTime(lines: any[]) {
      const targetTimeInput = this.querySelector('#target-time') as HTMLInputElement;
      const desiredTime = targetTimeInput?.value;
      let earliestArrival: Date | null = null;
      
      // Safety buffer in minutes
      const SAFE_BUFFER = 7; 

      for (const l of lines) {
        try {
          const data = await API.getStopArrivals(l.originStop.id);
          const infoDiv = this.querySelector(`.real-time-info[data-stop-id="${l.originStop.id}"][data-line-id="${l.lineId}"]`);
          
          if (!infoDiv) continue;

          if (data.resultado === 'OK' && data.buses && data.buses.lineas) {
            const lineInfo = data.buses.lineas.find((bl: any) => bl.linea.toString() === l.lineId.toString());
            
            if (lineInfo && lineInfo.buses && lineInfo.buses.length > 0) {
              let selectedBus = lineInfo.buses[0];
              let selectedArrivalAtDest = new Date();
              let isRecommended = false;

              if (this.plannerMode === 'arrive' && desiredTime) {
                // Arrive By Mode: Calculate the best bus to reach destination on time
                // Modo Llegar a las...: Calcular el mejor bus para llegar al destino a tiempo
                const [h, m] = desiredTime.split(':').map(Number);
                const targetDate = new Date();
                targetDate.setHours(h, m, 0, 0);
                if (targetDate < new Date()) targetDate.setDate(targetDate.getDate() + 1);

                // Find all buses and their arrival times
                // Buscar todos los buses y sus tiempos de llegada
                const possibleBuses = lineInfo.buses.map((b: any) => {
                  const bTime = typeof b.tiempo === 'number' ? b.tiempo : parseInt(b.tiempo) || 0;
                  const arr = new Date();
                  arr.setMinutes(arr.getMinutes() + bTime + l.estimatedTravelMins + (l.isNearby ? Math.round(l.walkToDest/60) : 0));
                  const diffMins = Math.round((targetDate.getTime() - arr.getTime()) / 60000);
                  return { bus: b, arrival: arr, waitTime: bTime, diffMins, isLate: diffMins < 0 };
                });

                const safeBuses = possibleBuses.filter(pb => !pb.isLate);

                // Get recommended bus (latest safe one)
                // Obtener bus recomendado (el último de los seguros)
                const recommended = safeBuses.length > 0 
                  ? [...safeBuses].sort((a: any, b: any) => b.arrival.getTime() - a.arrival.getTime())[0]
                  : possibleBuses[0];

                // Get second option (one before recommended in safe list, or first one after)
                // Obtener segunda opción (el anterior al recomendado en la lista segura)
                const sortedSafe = [...safeBuses].sort((a: any, b: any) => a.arrival.getTime() - b.arrival.getTime());
                const recIdx = sortedSafe.findIndex(s => s.bus.bus === recommended.bus.bus);
                const secondOption = recIdx > 0 ? sortedSafe[recIdx - 1] : sortedSafe[recIdx + 1];

                if (!earliestArrival || recommended.arrival < earliestArrival) {
                  earliestArrival = recommended.arrival;
                }

                // Render all buses with the recommended one highlighted
                // Renderizar todos los buses destacando el recomendado
                const shownBusesIds = [recommended.bus.bus, secondOption?.bus.bus].filter(Boolean);
                const hiddenCount = possibleBuses.filter(pb => !shownBusesIds.includes(pb.bus.bus)).length;
                const toggleBtnText = lang === 'en'
                  ? `Show ${hiddenCount} more (including late buses)`
                  : `Mostrar ${hiddenCount} más (incluyendo buses tarde)`;

                infoDiv.innerHTML = `
                  <div class="buses-timeline">
                    ${possibleBuses.map((pb: any, idx: number) => {
                      const isRec = pb.bus.bus === recommended.bus.bus;
                      const isSecond = pb.bus.bus === secondOption?.bus.bus;
                      const isShown = isRec || isSecond;
                      
                      const arrivalAtOrigin = new Date(Date.now() + pb.waitTime * 60000);
                      const lateWarning = pb.isLate
                        ? (lang === 'en' ? `⚠️ Arriving late (${Math.abs(pb.diffMins)} min late)` : `⚠️ Llega tarde (${Math.abs(pb.diffMins)} min tarde)`)
                        : '';

                      return `
                        <div class="bus-status ${isRec ? 'success recommended' : (pb.isLate ? 'error' : 'secondary')} ${!isShown ? 'hidden-bus' : ''}" data-bus-idx="${idx}">
                          <div class="eta">
                            <span class="time">${pb.waitTime}</span>
                            <span class="unit">min</span>
                          </div>
                          <div class="details">
                            ${isRec ? `<p><strong style="color: #059669;">${lang === 'en' ? '✨ Recommended' : '✨ Recomendado'}</strong></p>` : ''}
                            ${isSecond ? `<p><strong style="color: #475569;">${lang === 'en' ? '🥈 Second choice' : '🥈 Segunda opción'}</strong></p>` : ''}
                            ${pb.isLate ? `<p><strong style="color: #dc2626;">${lateWarning}</strong></p>` : ''}
                            
                            <div class="time-step">
                               <span class="dot origin"></span>
                               <p>${lang === 'en' ? 'Passes by stop:' : 'Pasa por parada:'} <strong>${this.formatTime(arrivalAtOrigin)}</strong></p>
                            </div>
                            <div class="time-step">
                               <span class="dot bus"></span>
                               <p>${lang === 'en' ? 'Destination arrival:' : 'Llegada destino:'} <strong>${this.formatTime(pb.arrival)}</strong> 
                                  <small>(${pb.isLate ? '' : (lang === 'en' ? 'arrives ' : 'llega ')}${Math.abs(pb.diffMins)} min ${pb.isLate ? (lang === 'en' ? 'after' : 'después') : (lang === 'en' ? 'early' : 'antes')})</small>
                               </p>
                            </div>
                            
                            <div class="bus-actions">
                              <small>${lang === 'en' ? 'Vehicle no:' : 'Vehículo nº:'} <strong>${pb.bus.bus || '---'}</strong></small>
                              <button class="btn-track-this-bus" 
                                      data-bus="${pb.bus.bus}" 
                                      data-line="${l.lineId}" 
                                      data-origin="${l.originStop.id}" 
                                      data-dest="${l.destStop.id}"
                                      title="${lang === 'en' ? 'Track this specific bus' : 'Seguir este bus específico'}">
                                <i data-lucide="navigation" style="width: 14px; height: 14px;"></i> ${lang === 'en' ? 'Track' : 'Seguir'}
                              </button>
                            </div>
                          </div>
                        </div>
                      `;
                    }).join('')}
                    ${hiddenCount > 0 ? `
                      <button class="btn-toggle-buses" type="button">
                        <span class="text-show">${toggleBtnText}</span>
                        <span class="text-hide">${lang === 'en' ? 'Hide alternatives' : 'Ocultar alternativas'}</span>
                      </button>
                    ` : ''}
                  </div>
                `;

                // Add toggle listener
                infoDiv.querySelector('.btn-toggle-buses')?.addEventListener('click', (e) => {
                  e.stopPropagation();
                  const container = (e.currentTarget as HTMLElement).closest('.buses-timeline');
                  container?.classList.toggle('expanded');
                });

                // Add tracking listeners to specific buses
                infoDiv.querySelectorAll('.btn-track-this-bus').forEach(btn => {
                  btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const busId = btn.getAttribute('data-bus');
                    if (!busId) return;

                    import('../utils/tracking').then(({ tracking }) => {
                      tracking.set({
                        busId: busId,
                        lineId: parseInt(btn.getAttribute('data-line')!),
                        originStopId: parseInt(btn.getAttribute('data-origin')!),
                        destinationStopId: parseInt(btn.getAttribute('data-dest')!),
                        lastEta: null,
                        arrivalTime: null
                      });
                      alert(lang === 'en' ? `Tracking started for bus ${busId}!` : `¡Seguimiento iniciado for el bus ${busId}!`);
                    });
                  });
                });
                
                this.renderIcons();

              } else {
                // Default mode: next bus available
                // Modo por defecto: siguiente bus disponible
                const selectedBus = lineInfo.buses[0];
                const busTime = typeof selectedBus.tiempo === 'number' ? selectedBus.tiempo : parseInt(selectedBus.tiempo) || 0;
                const arrivalAtDest = new Date();
                arrivalAtDest.setMinutes(arrivalAtDest.getMinutes() + busTime + l.estimatedTravelMins + (l.isNearby ? Math.round(l.walkToDest/60) : 0));
                
                if (!earliestArrival || arrivalAtDest < earliestArrival) {
                  earliestArrival = arrivalAtDest;
                }

                const arrivalAtOrigin = new Date(Date.now() + (busTime * 60000));

                infoDiv.innerHTML = `
                  <div class="bus-status success">
                    <div class="eta">
                      <span class="time">${busTime}</span>
                      <span class="unit">min</span>
                    </div>
                    <div class="details">
                      <p>${lang === 'en' ? 'Passes by stop:' : 'Pasa por parada:'} <strong>${this.formatTime(arrivalAtOrigin)}</strong></p>
                      <p>${lang === 'en' ? 'Estimated arrival:' : 'Llegada estimada:'} <strong>${this.formatTime(arrivalAtDest)}</strong></p>
                      <div class="bus-actions">
                        <small>${lang === 'en' ? 'Vehicle no:' : 'Vehículo nº:'} <strong>${selectedBus.bus || '---'}</strong></small>
                        <button class="btn-track-this-bus" 
                                data-bus="${selectedBus.bus}" 
                                data-line="${l.lineId}" 
                                data-origin="${l.originStop.id}" 
                                data-dest="${l.destStop.id}">
                          <i data-lucide="navigation" style="width: 14px; height: 14px;"></i> ${lang === 'en' ? 'Track' : 'Seguir'}
                        </button>
                      </div>
                    </div>
                  </div>
                `;

                infoDiv.querySelector('.btn-track-this-bus')?.addEventListener('click', (e) => {
                  e.stopPropagation();
                  const busId = (e.currentTarget as HTMLElement).getAttribute('data-bus');
                  if (!busId) return;
                  import('../utils/tracking').then(({ tracking }) => {
                    tracking.set({
                      busId: busId,
                      lineId: l.lineId,
                      originStopId: l.originStop.id,
                      destinationStopId: l.destStop.id,
                      lastEta: null,
                      arrivalTime: null
                    });
                    alert(lang === 'en' ? `Tracking started for bus ${busId}!` : `¡Seguimiento iniciado para el bus ${busId}!`);
                  });
                });

                this.renderIcons();
              }
            } else {
              infoDiv.innerHTML = `<div class="bus-status warning">Sin buses próximos en tiempo real.</div>`;
            }
          } else {
            infoDiv.innerHTML = `<div class="bus-status warning">${lang === 'en' ? 'No upcoming buses in real-time.' : 'Sin buses próximos en tiempo real.'}</div>`;
          }
        } catch (err) {
          console.error(err);
        }
      }

      // Check against desired arrival time for global warning
      if (this.plannerMode === 'arrive' && desiredTime && earliestArrival) {
        const [h, m] = desiredTime.split(':').map(Number);
        const desiredDate = new Date();
        desiredDate.setHours(h, m, 0, 0);
        
        if (desiredDate < new Date()) {
          desiredDate.setDate(desiredDate.getDate() + 1);
        }

        const warning = this.querySelector('#taxi-warning') as HTMLElement;
        if (earliestArrival > desiredDate) {
          if (warning) {
            warning.style.display = 'block';
            warning.innerHTML = lang === 'en' ? '🚕 No bus seems to arrive on time... you might need to take a taxi!' : '🚕 Ningún bus parece llegar a tiempo... ¡va a haber que coger un taxi!';
          }
        } else {
          if (warning) warning.style.display = 'none';
        }
      }
    }

    formatTime(date: Date) {
      return date.toLocaleTimeString(lang === 'en' ? 'en-US' : 'es-ES', { hour: '2-digit', minute: '2-digit' });
    }
  }

  customElements.define('trip-calculator', TripCalculator);
</script>
