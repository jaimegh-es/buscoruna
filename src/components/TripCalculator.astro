                  if (item.classList.contains('current-pos')) {
                    const originInput = this.querySelector('#origin') as HTMLInputElement;
                    if (originInput) originInput.value = lang === 'en' ? "My location" : "Mi ubicación";
                    this.selectedOrigin = {
                      type: 'place',
                      nombre: lang === 'en' ? "My location" : "Mi ubicación",
                      posy: latitude,
                      posx: longitude
                    };
                  } else {
                    const id = item.getAttribute('data-id');
                    const name = item.getAttribute('data-name');
                    input.value = name || '';
                    const stop = this.catalog.paradas[id!];
