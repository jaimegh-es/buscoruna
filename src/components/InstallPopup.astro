---
import Icon from './Icon.astro';
---

<div id="install-popup" class="install-popup" style="display: none;">
  <div class="install-content">
    <div class="install-header">
      <img src="/logo.png" alt="Coruña Bus" class="install-logo" />
      <div class="install-text">
        <strong>Instalar Coruña Bus</strong>
        <p>Añade la app a tu pantalla de inicio para un acceso rápido.</p>
      </div>
      <button id="close-install" class="close-install-btn">
        <Icon name="x" size={20} />
      </button>
    </div>
    <button id="do-install" class="btn-primary install-action-btn">
      Instalar ahora
    </button>
  </div>
</div>

<style>
  .install-popup {
    position: fixed;
    bottom: calc(var(--nav-height) + 20px);
    left: 1rem;
    right: 1rem;
    background: white;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    z-index: 4000;
    padding: 1.25rem;
    animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid #eee;
  }

  @keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .install-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .install-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
  }

  .install-logo {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }

  .install-text {
    flex: 1;
    padding-right: 2rem;
  }

  .install-text strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .install-text p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.3;
    margin: 0;
  }

  .close-install-btn {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #f5f5f7;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
  }

  .install-action-btn {
    margin: 0;
  }
</style>

<script>
  let deferredPrompt: any;
  const popup = document.getElementById('install-popup');
  const installBtn = document.getElementById('do-install');
  const closeBtn = document.getElementById('close-install');

  window.addEventListener('beforeinstallprompt', (e) => {
    // Prevent Chrome 67 and earlier from automatically showing the prompt
    e.preventDefault();
    // Stash the event so it can be triggered later.
    deferredPrompt = e;
    
    // Check if we've already shown it recently
    const lastShown = localStorage.getItem('pwa-prompt-last-shown');
    const now = Date.now();
    
    // Show every 7 days if not installed
    if (!lastShown || now - parseInt(lastShown) > 7 * 24 * 60 * 60 * 1000) {
      if (popup) popup.style.display = 'block';
    }
  });

  installBtn?.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    
    // Show the prompt
    deferredPrompt.prompt();
    // Wait for the user to respond to the prompt
    const { outcome } = await deferredPrompt.userChoice;
    
    if (outcome === 'accepted') {
      console.log('User accepted the install prompt');
    } else {
      console.log('User dismissed the install prompt');
    }
    
    // We've used the prompt, and can't use it again
    deferredPrompt = null;
    if (popup) popup.style.display = 'none';
  });

  closeBtn?.addEventListener('click', () => {
    if (popup) popup.style.display = 'none';
    localStorage.setItem('pwa-prompt-last-shown', Date.now().toString());
  });

  window.addEventListener('appinstalled', () => {
    // Hide the app-provided install promotion
    if (popup) popup.style.display = 'none';
    // Clear the deferredPrompt so it can be garbage collected
    deferredPrompt = null;
    console.log('PWA was installed');
  });
</script>
